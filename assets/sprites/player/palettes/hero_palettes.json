  "match": "a texel whose RGB equals key entry i (all 8-bit channels equal; in a shader |d| < 0.5 / 255) becomes slot_lut[i] with the texel's own alpha; key entries with alpha 0 are unused",
  "pattern": "for entries 0-2 (cloth, shadow, ink) inside the cell's cloth window: t = cloth texel at (column * w + x - window.x, row * h + y - window.y); bits = t.r + 256 * t.g (bytes); entry = bit(pattern) ? 2 : (t.b == 2 ? 1 : 0)",
  "sampling": "all three textures: filter nearest, no repeat, no mipmaps, read as raw bytes (no sRGB conversion)",
  "non_hero_sheets": "hero_egg.png and any other sprite drawn in key colours: LUT only, pattern step off"
