# Godot 4 cache (regenerated by the editor / --import); *.import files next to assets ARE committed
.godot/
.import/
*.translation
export_credentials.cfg

# Local tooling: engine binaries, Python venv, asset staging area, reference clones
# (only the shared Godot runner script is versioned)
.tools/*
!.tools/gd.sh

# Build output (exports, QA screenshots); keep the folder marker
build/*
!build/.gdignore

# Android / iOS / mono leftovers
android/build/
*.keystore
*.jks
.mono/
data_*/
mono_crash.*.json

# Python
__pycache__/
*.pyc

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
*~
.vscode/
.idea/

# Claude Code local session files
.claude/scheduled_tasks.lock
.claude/settings.local.json
