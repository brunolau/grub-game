# Club & Grub 1.0.0 save fixture "mid_expert" (tests/data/saves_1_0/README.md): one profile with progress in BOTH
# difficulties. Played by the 1.0.0 release (git tag v1.0.0) through its own flow runner, from an empty user folder:
# Start > Expert, 1-1, 1-2 with the warp into Feast Land A, 2-1 Echo Caverns (the run then stands before 2-2 with the
# hammer), back to the title; Start > Beginner, 1-1; back to the title; Options: master volume two steps down, smooth
# camera on, vibration off, and two rebinds - strike on H (the key Space leaves the action) and then jump on Space.

wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 40
expect save.has_progress() == false
press ui_accept
wait_until flow.current_screen == mode_select 300
wait_until flow.busy == false 600
press ui_right
wait 10
press ui_accept
wait_until flow.current_screen == world_map 300
wait_until flow.busy == false 600
expect game.difficulty == 1

# --- 1-1 Vine Bridges ------------------------------------------------------------------------------------------------
expect flow.args.level_id == w1_l1
wait_until scene.countdown >= 0 600
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w1_l1 600
wait 2
play_file tools/autoplay/routes/w1_l1.expert.inputs
expect events.player_died == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
press ui_accept
wait 20
press ui_accept
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect save.get_level_result(w1_l1,1).clears == 1
expect save.is_level_unlocked(w1_l2,1) == true

# --- 1-2 Canopy Village: the warp into Feast Land A ------------------------------------------------------------------
expect flow.args.level_id == w1_l2
wait_until scene.countdown >= 0 600
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w1_l2 600
wait 2
play_file tools/autoplay/routes/w1_l2.warp.inputs
expect events.player_died == 0
expect game.weapon == 2
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == bonus_a 600
wait 2
play_file tools/autoplay/routes/bonus_a.axe.inputs
expect events.player_died == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
press ui_accept
wait 20
press ui_accept
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect save.get_level_result(w1_l2,1).clears == 1
expect save.is_level_unlocked(w2_l1,1) == true

# --- 2-1 Echo Caverns ------------------------------------------------------------------------------------------------
expect flow.args.level_id == w2_l1
wait_until scene.countdown >= 0 600
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w2_l1 600
wait 2
play_file tools/autoplay/routes/w2_l1.expert.axe.inputs
expect events.player_died == 0
expect game.weapon == 1
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
press ui_accept
wait 20
press ui_accept
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect save.get_level_result(w2_l1,1).clears == 1
expect save.is_level_unlocked(w2_l2,1) == true
expect flow.args.level_id == w2_l2
wait 20

# --- Back to the title; a Beginner run through 1-1 -------------------------------------------------------------------
press ui_cancel
wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 20
press ui_accept
wait_until flow.current_screen == mode_select 300
wait_until flow.busy == false 600
wait 10
press ui_left
wait 10
press ui_accept
wait_until flow.current_screen == world_map 300
wait_until flow.busy == false 600
expect game.difficulty == 0
expect flow.args.level_id == w1_l1
wait_until scene.countdown >= 0 600
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w1_l1 600
wait 2
reset_events
play_file tools/autoplay/routes/w1_l1.inputs
expect events.player_died == 0
expect events.exit_reached == 1
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
press ui_accept
wait 20
press ui_accept
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect save.get_level_result(w1_l1,0).clears == 1
expect save.is_level_unlocked(w1_l2,0) == true
wait 20
press ui_cancel
wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 20

# --- Options ---------------------------------------------------------------------------------------------------------
# Rows: Master, Music, Effects, Fullscreen, VSync, Screen shake, Flashes, Smooth camera, Key bindings >, Up jumps,
# Vibration, Language, Reset, Erase, Back.
press ui_down
press ui_down
press ui_accept
wait_until flow.current_screen == options 300
wait_until flow.busy == false 600
wait 30
press ui_left
press ui_left
press ui_down
press ui_down
press ui_down
press ui_down
press ui_down
press ui_down
press ui_down
press ui_accept
press ui_down
press ui_accept
wait 10
# The bindings page: Left, Right, Up, Down, Jump, Strike, Look, Pause, Reset, Back.
press ui_down
press ui_down
press ui_down
press ui_down
press ui_down
press ui_accept
wait 6
key H
wait 6
press ui_up
press ui_accept
wait 6
key Space
wait 6
press ui_cancel
wait 10
press ui_down
press ui_down
press ui_accept
wait 10
expect settings.audio/master < 0.9
expect settings.audio/music == 0.8
expect settings.camera/smooth_follow == true
expect settings.controls/vibration == false
expect settings.controls/up_jumps == true
expect settings.video/screen_shake == true
expect settings.video/fullscreen == false
press ui_cancel
wait_until flow.current_screen == title 300
wait_until flow.busy == false 600
wait 20
