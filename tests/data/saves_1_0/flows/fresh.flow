# Club & Grub 1.0.0 save fixture "fresh" (tests/data/saves_1_0/README.md): a player who installed the game, started
# a Beginner run, walked a few steps into 1-1, left through the pause menu and quit. Played by the 1.0.0 release
# (git tag v1.0.0) through its own flow runner, from an empty user folder.

wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 40
expect save.has_progress() == false
press ui_accept
wait_until flow.current_screen == mode_select 300
wait_until flow.busy == false 600
press ui_accept
wait_until flow.current_screen == world_map 300
wait_until flow.busy == false 600
expect game.difficulty == 0
expect flow.args.level_id == w1_l1
wait_until scene.countdown >= 0 600
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w1_l1 600
wait 2
play 60:R

# Quit to the title through the pause menu (Resume, Checkpoint, Restart, Options, Quit).
press pause
wait 6
press ui_down
press ui_down
press ui_down
press ui_down
press ui_accept
wait 6
press ui_accept
wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
expect tree.paused == false
expect save.has_progress() == false
wait 30
