# --- The End, credits, title --------------------------------------------------------------------------------------
wait_until flow.current_screen == the_end 900
wait_until flow.busy == false 600
expect save.is_game_completed(1) == true
expect save.is_game_completed(0) == false
expect save.get_high_score() >= 1000000
expect game.lives >= 2
expect save.get_level_result(w1_l1,1).clears == 1
expect save.get_level_result(w1_l2,1).clears == 1
expect save.get_level_result(w2_l1,1).clears == 1
expect save.get_level_result(w2_l2,1).clears == 1
expect save.get_level_result(w3_l1,1).clears == 1
expect save.get_level_result(w3_l2,1).clears == 1
expect save.get_level_result(w4_l1,1).clears == 1
expect save.get_level_result(w4_l2,1).clears == 1
wait 90
press ui_accept
wait_until flow.current_screen == credits 900
wait_until flow.busy == false 600
wait 240
press ui_cancel
wait_until flow.current_screen == title 900
wait_until flow.busy == false 600
wait 30
expect save.has_progress() == true
expect events.player_died == 0

# --- Part 2: a Beginner run from the code of 3-2 to the expert wall (1.0.0 campaign_beginner.flow) ---------------
# (the event counters start again, as in a run of that flow by itself)
reset_events
# Short Beginner flow from a fresh save: title -> Continue -> the code of 3-2 Crystal Grotto (GR0T, typed
# with the letter O, which the code screen reads as the digit 0) -> world map -> Crystal Grotto played by its route
# -> tally -> the expert wall -> title. Checks the code screen, the Beginner record, that the Expert-only world 4
# stays locked and that a Beginner run ends at the wall without completing the game. The whole Beginner campaign is
# played headless by tests/test_campaign_routes.gd test_the_beginner_campaign_in_one_run.

wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 30
# Continue: the code screen.
press ui_down
press ui_accept
wait_until flow.current_screen == code_entry 300
wait_until flow.busy == false 600
wait 20
key G R O T
wait_until flow.current_screen == world_map 600
wait_until flow.busy == false 600
expect flow.args.level_id == w3_l2
expect game.difficulty == 0
expect game.lives == 2
expect game.weapon == 0
wait_until scene.countdown >= 0 600
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w3_l2 600
expect hero.dead == false
expect hud.shown_hearts == 3
wait 2
play_file tools/autoplay/routes/w3_l2.inputs
expect events.player_died == 0
expect events.exit_reached == 1
expect game.weapon == 3
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
press ui_accept
wait 20
press ui_accept

# Crystal Grotto is the last Beginner level: the expert wall, then the title.
wait_until flow.current_screen == expert_wall 900
wait_until flow.busy == false 600
expect save.get_level_result(w3_l2,0).clears == 1
expect save.is_game_completed(0) == false
expect save.is_level_unlocked(w4_l1,0) == false
wait 90
press ui_accept
wait_until flow.current_screen == title 900
wait_until flow.busy == false 600
wait 30
