# Club & Grub - World 7, stage 2 in co-op: "Sea Caves" (designer D7). The co-op file of levels/w7_l2.lvl
# (DESIGN.md A.6 / D.10, LEVEL_DESIGN.md 15.7): the same caves with P2's start and two co-op gates on the main
# path, each with its tablet and a checkpoint behind:
#  - 'seagate': leapfrog plate doors in a sea wall on the drift-log ledge, both doors in one view - plate A
#    before the wall holds the lower tunnel's door for the partner; plate B beyond it holds the upper tunnel's
#    door for the holder, who climbs two driftwood shelves (letter S waits in the upper tunnel); each plate 8
#    tiles from its door;
#  - 'dark_gap': a Batter Up line drive - the floes after the islet are gone: 9 cells of dark water (8 on
#    Beginner: a block at the near lip); one hero curls at the islet's edge, the other drives him over with a
#    forward strike; on the far shore he steps on the latch plate and a stepping stone rises out of the lake for
#    the batter.
# The drift-log jam, its bark boards, the letter shelf and the blowhole are inside the wall; checkpoint 2 moves to
# the middle ledge. Traits: the ceiling octopi are leeches, the jelly flyers `lone`, a Snatcher gull (`grab`) over
# the first floe channel. Left out: the jelly by the
# letter shelf and the one over the dark gap. The floes carry their riders 24 ticks (10 in the solo file).

[meta]
format = 2
id = w7_l2_coop
name = "Sea Caves"
kind = coop
coop_of = w7_l2
coop_base_hash = "a4a5e8111a173ee407b6abd7ca4d88194978c41b788add7c463546a7c2091523"
book = 2
world = 7
stage = 2
biome = coast
terrain_a = coast/terrain_cave
terrain_b = coast/terrain
background = sea_cave
music = level_sea_caves
liquid = water
tally = false
next = w7_l2b
bonus_tier = 1
author = D7

[legend]
o = objects/drop_platform skin=driftwood delay=24
C = objects/checkpoint
E = objects/exit

