# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7). World 2, stage 2 (second half): "Brute's Den".
# Linked sub-stage of w2_l2 (Bone Gorge): its exit leads here without a tally. A short bone tunnel with a heart
# refill and a checkpoint, then the hero drops into a walled one-screen den where BOSS 1, the Brute, waits.
# Only its head is soft (high strikes, strikes from above after a bounce on the head, charged strikes); beating
# it drops the fire-starter that lights the locked exit totem in the den. The tally after it ends Bone Gorge.

[meta]
format = 1
id = w2_l2b
name = "Brute's Den"
kind = sub
world = 2
stage = 2
biome = cave
terrain_a = cave/terrain_stone
terrain_b = cave/terrain
background = cave
music = level_cave
password_beginner = "R0AR"
password_expert = "F1ST"
bonus_tier = 1
author = w2
notes = "World 2-2b: the Brute (boss 1) in a walled den; it drops the fire-starter for the locked exit."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:44,heart,food:33 look=inset tile=#
k = objects/hidden_spot kind=small count=2 contents=food:36,food:29 tile=#
E = objects/exit locked=true
C = objects/checkpoint
a = items/food index=33
b = items/food index=46
Y = items/heart

