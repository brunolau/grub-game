d = enemies/dart skin=pterodactyl_b range=7 speed=4 hp=10 expert
X = enemies/leaper skin=dragon_b pause=110 hp=10
A = enemies/dangler skin=bat_b depth=56 hp=10
f = items/food index=34
g = items/food index=32
k = items/food index=19
c = items/food index=31
j = items/treasure index=10
