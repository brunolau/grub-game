# Club & Grub - World 3, stage 2 co-op: "Crystal Grotto" for two (designer DB3; docs/expansion/DESIGN.md D.9,
# LEVEL_DESIGN.md 15.7). The co-op file of levels/w3_l2.lvl (kind = coop, coop_of, coop_base_hash; never edit the
# solo file): the same mountain - the crystal gallery, the leaper lake, the chasm floe, the lower gallery, the
# crystal shaft and the skylight cave - for two.
# Co-op gates (both at the leaper lake, its wide pool narrowed to 9 cells of icy water; the near bank is a rock lip
# two rows over the far one, from which a line drive carries over and a running jump falls short):
#  - "drive": a Batter Up line drive - one hero curls at the bank's edge and his partner bats him over the pool;
#  - "floes": the twin drums - the batted hero strikes the far bank's drum while his partner strikes the near
#    bank's drum on the count of three: the floes under the surface freeze into a bridge and the batter walks over.
#    The drums stand 19 columns apart, so one hero alone needs far longer than the window (and no throw from one
#    bank reaches the other drum).
# Traits: the walking turtles are Shellbacks (shell), the hoppers Raptors (daze), and the lower gallery's two ice
# pits hold twin leapers (bond, 17 columns apart). The warp to Feast Land C moved up into the crystal cache, a
# boost ledge 8 rows over the skylight cave's floor: one hero Shoulder-Hops there off his partner's head - the x2
# secret, with Cave Painting 26. Checkpoint behind the gates on the far bank.

[meta]
format = 2
id = w3_l2_coop
name = "Crystal Grotto"
kind = coop
coop_of = w3_l2
coop_base_hash = "f62d74e708c0bfb6da25c2be0add533555e13e535dcf56ef1acf0d5e2a22cd09"
book = 1
world = 3
stage = 2
biome = ice
terrain_a = ice/terrain_rock
terrain_b = ice/terrain
ice_a = 0
ice_b = 2
liquid = ice_water
background = ice
music = level_grotto
bonus = bonus_c
bonus_tier = 1
author = DB3
notes = "Co-op 3-2: Batter Up line drive + twin drums over the leaper lake, Shellbacks, Raptors, twin leapers, the warp and painting 26 in the crystal cache (Shoulder Hop)."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:34,food:32,food:31 tile=#
i = objects/hidden_spot kind=small count=3 contents=food:34,food:32,treasure:3 look=inset tile=#
* = objects/hidden_spot kind=big hits=3 contents=giant:5 tile=#
$ = objects/breakable_block hits=2 contents=food:15 tile=;
r = objects/hidden_spot kind=small count=2 contents=food:3,food:2 tile=#
