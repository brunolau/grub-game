# ---- co-op (DB3) --------------------------------------------------------------------------------------------
objects/hero_start 3 17 slot=2
# The swirling axe of the gallery, in a pair (one for each hero): the second hangs three rows over the first,
# so the hero who walks over the first leaves it to his partner (a jump takes it).
items/weapon 59 26 kind=boomerang
# The first turtle carries its shell to the nearer caveman (a Shellback): one hero in front, the other behind.
enemies/walker 13 17 skin=turtle_b left=0 right=0 speed=0 hp=10 coop=shell
objects/sign 9 17 text=SIGN_COOP_W3_SHELL
# Gates "drive" and "floes" at the leaper lake (DESIGN.md D.9 3-2). Near bank cols 92-95, the icy pool 96-104 (9
# cells; on Beginner a frozen floe at col 96 leaves 8), far bank 105-111. The floe bridge waits under the surface
# (row 37) and rises once when both drums are struck within the window.
objects/sign 85 35 text=SIGN_COOP_W3_DRIVE
objects/x2_tablet 93 33 gate=drive far=106,35
objects/drum 89 33 bond=floes
objects/drum 108 35 bond=floes
objects/x2_tablet 87 33 gate=floes far=110,35
objects/sign 110 35 text=SIGN_COOP_W3_DRUMS
objects/column 96 37 size=9,1 rise=1 trigger=drums:floes
# Beginner: a frozen floe lengthens the near lip by one cell (8 cells of water to the far bank, R17).
objects/column 96 35 size=1,2 rise=0 beginner
objects/checkpoint 106 35
# The lower gallery: on Expert a Raptor waits on the rock before the first ice pit (5 columns from the
# checkpoint, range 3), fought on solid ground; on the ice between the pits a Shellback and the twin leapers of
# the two pits (17 columns apart: no single hero clubs both inside the window).
enemies/raptor 122 53 skin=mini_rex_b range=3 hp=10 expert
enemies/walker 132 53 skin=turtle_b left=-3 right=3 hp=10 coop=shell
enemies/leaper 125 53 skin=dragon_b pause=110 hp=10 coop=bond bond=pits
enemies/leaper 142 53 skin=dragon_b pause=110 hp=10 coop=bond bond=pits
# The hopper by the exit became a Raptor and moved down to the lower gallery (no bouncing near the cache ledge):
# on the ice between the pits on Beginner, on the rock after the second pit on Expert (the Expert ice strip keeps
# only the Shellback and the leapers: both Expert Raptors are fought on solid ground).
enemies/raptor 136 53 skin=mini_rex_b range=4 hp=10 beginner
enemies/raptor 150 53 skin=mini_rex_b range=3 hp=10 expert
# The x2 secret: the crystal cache in the chimney's wall, its ledge 8 rows over the exit floor (a boost ledge:
# Shoulder Hop). It holds Cave Painting 26 and the warp to Feast Land C.
objects/x2_tablet 170 35 secret far=165,27
items/painting 165 27 index=26
items/warp 161 27
zones/secret 163 26 name=crystal_cache rect=160,25,8,3
objects/sign 173 35 text=SIGN_COOP_W3_CACHE
props/cave/crystal_cyan_a 162 27
props/cave/crystal_violet_b 164 27
props/cave/crystal_cyan_d 160 27
props/ice/icicle 162 25
props/ice/icicle 164 25
props/cave/crystal_violet_d 167 27

