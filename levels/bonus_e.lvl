# Club & Grub - Feast Land E: "Pudding Lagoon" (designer D7, Book II "The Far Shore"), the bonus stage of 7-1.
# Food-made and enemy-light like Feast Lands A-D (DESIGN.md A.2 / A.6, GAMEPLAY.md 13.2): custard islands under a
# caramel top (`:` custard floors: the tar rules in a syrup skin), deadly berry syrup between them and wafer rafts
# on its currents under a rain of fruit; spots in every island. The landing island, the first wafer reach,
# checkpoint 1 on the jelly island, the fast second reach, checkpoint 2 on the long biscuit island; a hole in it
# drops into the syrup grotto (a vine climbs back out), where a side current carries a raft to the cove of the Cave
# Painting (index 18, in a big spot) and a spring throws the hero back up through a hatch; the third reach and the
# warp home on the last
# island. Four jelly flyers, no Expert extras, no pits.

[meta]
format = 2
id = bonus_e
name = "Feast Land E"
kind = bonus
book = 2
order = 0
world = 0
stage = 0
biome = feast
terrain_a = feast/terrain_pudding
terrain_b = feast/terrain_biscuit
background = feast
music = bonus_lagoon
liquid = syrup
bonus_tier = 2
author = D7
notes = "Bonus stage E, entered from w7_l1 (meta bonus = bonus_e). 60-90 s. No level codes: only the warp leads here."

[legend]
a = objects/hidden_spot kind=small count=3 contents=food:24,food:25,food:26 look=inset tile=#
b = objects/hidden_spot kind=small count=3 contents=food:27,food:28,treasure:2 look=inset tile=#
c = objects/hidden_spot kind=small count=3 contents=food:29,food:30,food:31 look=inset tile=%
d = objects/hidden_spot kind=small count=2 contents=treasure:4,food:32 look=inset tile=#
B = objects/hidden_spot kind=big hits=3 contents=giant:3 look=block tile=#
P = objects/hidden_spot kind=big hits=3 contents=painting:18 look=inset tile=#
C = objects/checkpoint

