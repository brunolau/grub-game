# Club & Grub - World 6, stage 1 for two: "Bubbling Fen" co-op (designer D6, Book II "The Far Shore").
# The solo fen (w6_l1) for a tribe of two (DESIGN.md A.6 / D.10, LEVEL_DESIGN.md 15.7): the landing shore and
# the raft reach as in solo (a raft for two: one paddles, the other clubs the tar blobs that drop on it); then two
# co-op gates on the main path, each with its x2 tablet and a checkpoint behind it:
#  - 'sunk': where the raft sank, a Batter Up gap - 8 cells of open tar (9 on Expert: a Beginner-only block fills
#    the ninth) between two banks at one height under open sky, no raft: one curls up (Down + Swap), the other bats
#    him over with a forward strike; on the far bank a latch plate 8 cells on raises the sunken raft (a column
#    under the tar) for the batter;
#  - 'root': Old Root, a mangrove root 8 rows over the floor in front of it (A.6's fallback for "thorns": a lone
#    rider crosses a thorn bed in 24 ticks and the Leeches only drain bones, so Chomper's two seats cannot be a
#    gate): a Shoulder Hop takes one up, who clubs the rolled vine down for his partner (its coil 12 cells from
#    the far cell behind the root); both drop behind it. It stands before Chomper, who never gets near it.
# Then wild Chomper with his two seats (the first to sit drives and bites, the partner on his back clubs) and the
# tar flats. Traits: Tar Splitters and split tar blobs, Leeches under the root deck (only the partner clubs one off
# a back), a bonded frog pair (18 columns and 4 rows apart: no thrown special from beside one crosses the other),
# lone mosquitoes. The hammer lies on the jetty in a pair.

[meta]
format = 2
id = w6_l1_coop
name = "Bubbling Fen"
kind = coop
coop_of = w6_l1
coop_base_hash = 4bcd0963720f3151eda56a3406ef880fc80975fe8d137fc2b6bb25749eb02d72
book = 2
world = 6
stage = 1
biome = swamp
terrain_a = swamp/terrain
terrain_b = swamp/terrain_bark
background = swamp
music = level_fen
liquid = tar
bonus_tier = 1
author = D6

[legend]
V = objects/vine length=3
W = objects/vine length=7
T = objects/raft width=3 skin=log tile=~
C = objects/checkpoint
E = objects/exit

