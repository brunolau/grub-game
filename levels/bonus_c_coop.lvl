# Club & Grub - Feast Land C "Candy Road" for two (designer DB3; docs/expansion/DESIGN.md D.9, LEVEL_DESIGN.md
# 15.7). The co-op file of levels/bonus_c.lvl (kind = coop, coop_of, coop_base_hash; never edit the solo file): the
# bonus stage of 3-2 for two on the solo map - the biscuit causeway, the candy arcs, the big spring, the crumbling
# biscuit bridge and the spiral staff on its podium. A Feast Land in co-op has only its team exit (D.8 #1): no co-op
# gate, no enemies (so no trait share). P2 starts beside P1; the sugar room behind the cellar gate stays the secret
# (a team gate takes both heroes).

[meta]
format = 2
id = bonus_c_coop
name = "Feast Land C"
kind = coop
coop_of = bonus_c
coop_base_hash = "73864e631d49c26458b5ee367c75335c027e4f3fd160e6bc491f5c85be3b4f4f"
book = 1
order = 0
world = 0
stage = 0
biome = feast
terrain_a = feast/terrain_biscuit
terrain_b = feast/terrain_icing
ice_b = 1
background = feast
music = bonus
bonus_tier = 2
author = DB3
notes = "Co-op Feast Land C (bonus of w3_l2_coop): the solo causeway for two, team exit at the spiral staff."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:15,food:16,food:17 look=inset tile=#
* = objects/hidden_spot kind=big hits=3 contents=giant:2 look=block tile=#
