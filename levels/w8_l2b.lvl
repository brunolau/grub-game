# Club & Grub - World 8, stage 2b: "Idol Court" (designer D8, Book II "The Far Shore"; Expert only).
# A short approach along the temple roof (DESIGN.md A.3 / A.6 / B.4, difficulty 8): Cave Painting 11 waits in a
# chamber under two breakable floor blocks; a checkpoint; then a hole in the roof drops the hero onto the altar of
# the Idol Court - the fixed screen of GAMEPLAY 13.6 with the Twin Idols in both walls, the 2-row altar in the middle
# and a ledge at row 11 in front of each idol's jaws. One idol is awake and spits rocks, the other sleeps and drops
# masonry; strike the open jaws of the awake one (a high strike from its ledge, a forward strike when it slams low).
# Their fire-starter opens the exit totem on the altar.

[meta]
format = 2
id = w8_l2b
name = "Idol Court"
kind = sub
book = 2
world = 8
stage = 2
biome = ruins
terrain_a = ruins/terrain_carved
terrain_b = ruins/terrain
background = temple
music = level_idol_hall
min_difficulty = expert
password_expert = "TW1N"
bonus_tier = 2
author = D8

[legend]
C = objects/checkpoint
E = objects/exit locked=true
$ = objects/breakable_block tile=;

