# Club & Grub level file - format 2 (docs/ARCHITECTURE.md 7.11). Versus arena #6 of docs/expansion/DESIGN.md E.5:
# Coconut Cove - coast, walled, the Clubball pitch; sudden death: the high tide. Owner: DA (arenas,
# docs/expansion/PLAN.md 6.1). Rules: docs/LEVEL_DESIGN.md 15.8. Dressing: art-B's hand-over
# (.tools/asset_candidates/expansion/_handover/ARENA_DRESSING.md, "Coconut Cove").
#
# Layout notes (the E.5 sketch as drawn):
# - The pitch: a flat beach (row 10), the goal mouths 3 rows high at both ends (cols 0 / 19, rows 7-9, zones/goal:
#   team 1 defends the left one) under the coral rims (rows 4-6, cols 0-1 / 18-19); the two
#   low ledges (row 7, cols 6-7 / 12-13) 3 rows over the beach, the lob bridge (row 4, cols 6-13) 3 rows over them.
#   Routes: beach -> low ledge -> bridge -> rim (4 cells across). Keepers stand on the rims and volley down; the
#   bridge is where lobs are won.
# - The coconut drops in at the middle (x 160, objects/coconut col 9 dx=8) at the start and 66 ticks after a goal.
# - Spawns: four on the beach, two per side (Clubball puts each side on the spawns nearest its own goal: team 1 on
#   cols 1 / 4, team 2 on cols 18 / 15); 2 players use 1 and 2 (one per side).
# - Spots (4, visible): flush in the rims' tops at the walls (row 4, cols 0 / 19, a low strike from the rim) and in
#   the beach before the mouths (cols 3 / 16) - for the other modes; Clubball bots leave them alone. The rims are
#   straight (rows 4-6, cols 0-1 / 18-19: the sketch's extra cell in row 6 left a 14-cell "gap" warning).
# - Modes: Clubball only for now. In the other modes the goal mouths are meant to be ring-outs into the surf
#   (DESIGN.md E.5) - not built yet (asked of world-B); the arena gets those modes when that rule exists and their
#   bot sets are green.
# - Bot graph: resources/bots/arena_coconut_cove.json, baked with core-B's tool after every edit of this file:
#   bash .tools/gd.sh script res://tools/bots/bake_nav.gd -- arena_coconut_cove

[meta]
format = 2
id = arena_coconut_cove
name = "Coconut Cove"
kind = arena
biome = coast
terrain_a = coast/terrain_sand
terrain_b = coast/terrain
background = coast
music = versus_battle_a
players = 4
modes = clubball
round_time = 90
wrap = none
sudden = high_tide
author = DA
notes = "Versus arena 6 (DESIGN.md E.5): coast, walled; the Clubball pitch with goal mouths 3 rows high under the coral rims, two low ledges and the lob bridge."

[legend]
? = objects/hidden_spot kind=small count=3 look=block tile=#
r = objects/hidden_spot kind=small count=3 look=block tile=%
B = objects/spawn_point index=2
C = objects/spawn_point index=3
D = objects/spawn_point index=4

[tiles]
....................
....................
....................
....................
r%....--------....%r
%%................%%
%%................%%
......--....--......
....................
.@..C..........D..B.
###?############?###
####################

[entities]
objects/coconut 9 9 dx=8
zones/goal 0 7 rect=0,7,1,3 team=1
zones/goal 19 7 rect=19,7,1,3 team=2
props/coast/goal_post 0 9 layer=back
props/coast/goal_post 19 9 layer=back
props/coast/palm_tall 3 9 layer=back
props/coast/palm_short 16 9 layer=back
props/coast/shell_conch 6 9 layer=back
props/coast/shell_snail 13 9 layer=back
props/coast/seagrass_a 8 9 layer=back
props/coast/seagrass_b 11 9 layer=back
props/coast/coral_pink 0 3 layer=back
props/coast/coral_orange 19 3 layer=back
props/coast/dune_grass 1 3 layer=back
props/coast/seaweed 18 3 layer=back
