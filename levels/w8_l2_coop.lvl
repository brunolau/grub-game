# Club & Grub - World 8, stage 2 in co-op: "Hall of Idols" (designer D8). The co-op file of levels/w8_l2.lvl
# (DESIGN.md A.6 / D.10, LEVEL_DESIGN.md 15.7): the same maze of rooms with P2's start and two co-op gates on the
# main path, each with its x2 tablet and a checkpoint behind:
#  - 'rooms': the entrance hall and the spike room are joined by two corridors through their shared wall (no arch):
#    plate A in the hall holds the lower door while the partner goes through; on the far side he stands on plate B
#    on the step between the spike pits, which holds the upper door for the first hero (a leapfrog, two corridors);
#  - 'shamans': the guard hall of the long gallery is a closed keeper hall of a Shaman and two shell Guards under
#    four hatches, each over a perch (floor -> perch -> gallery: two short jumps). The heroes drop in on both sides
#    of the Shaman and pin him; then one baits each Guard's shield while the other climbs out by a perch, walks
#    the gallery and drops in behind it. The keeper door is the hall's right end; the arch to the last hall is
#    behind it.
# Co-op traits: the keepers and the scarabs, which are leeches (they ride a hero's back; only the partner clubs
# them off). Left out for the gates' role holders: the scarab over plate A, the one of the old guard hall, the
# guard gallery's Guard, the raptor by the spike room's arch and the two ghosts that would fly into the keeper hall.

[meta]
format = 2
id = w8_l2_coop
name = "Hall of Idols"
kind = coop
coop_of = w8_l2
coop_base_hash = "a5f4bdcac33ef20ceb5e2289159def39cb9a3fe980e76938c2f59886439a256b"
book = 2
world = 8
stage = 2
biome = ruins
terrain_a = ruins/terrain
terrain_b = ruins/terrain_carved
background = temple
music = level_idol_hall
liquid = water
min_difficulty = expert
next = w8_l2b_coop
tally = false
bonus_tier = 2
author = D8

[legend]
C = objects/checkpoint
E = objects/exit
$ = objects/breakable_block tile=;

