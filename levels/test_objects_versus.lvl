# Club & Grub level file - format 2 (docs/ARCHITECTURE.md 7.11). Test screen of objects-B's versus objects
# (docs/expansion/PLAN.md P2.7, pulled into phase 1): an arena-shaped single screen (20 x 12, floor row 10, row 0
# empty) with '@' and objects/spawn_point index=2..4 on the floor and two objects/cookpot on contested ground, mirrored
# tiers 3 rows apart. It is `kind = test`, not `arena`, so that it never appears in the versus arena list
# (LevelRegistry.get_arenas); tests/test_objects_versus.gd loads it through the real loader.

[meta]
format = 2
id = test_objects_versus
name = "Cookpot Yard"
kind = test
biome = jungle
terrain_a = jungle/terrain_grass
terrain_b = jungle/terrain
background = jungle
music = level_jungle
author = objects-B
notes = "objects-B test screen: four spawns and two cookpots (Grub Stack banking), never part of any campaign or arena list."

[legend]
K = objects/cookpot
f = items/food index=3

[tiles]
....................
....................
....................
....................
...f............f...
..=====......=====..
....................
....................
.........ff.........
....................
.@..K..........K....
####################

[entities]
objects/spawn_point 18 10 index=2
objects/spawn_point 6 4 index=3
objects/spawn_point 13 4 index=4
