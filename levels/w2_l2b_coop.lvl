[entities]
objects/hidden_spot 31 9 kind=small count=3 contents=food:38,food:40,treasure:10 prop=cave/skull_ribs
objects/sign 37 9 text=SIGN_W2_BRUTE
zones/arena 50 16 name=den rect=41,7,20,11 music=boss
# The Brute: a charged strike does 4 x the weapon (club 100, hammer 120 - the hero brings the hammer from w2_l1),
# so 150 / 250 hit points mean one free strike while it watches, then at least one more against the red Brute.
# Its limits sit one column inside the den walls: no corner is out of its reach. The den is open up to row 1 so
# the burst of bonuses (and the fire-starter) never lodges in the rock (build/engine_requests/review_w2.txt #1).
# Co-op (DB2, G35): the limits sit two columns inside the den walls (the solo file: one) - the head (29 px behind,
# 18 px in front of the feet point) stays inside the locked den view (cols 41-60) at both limits, either way it faces.
bosses/brute 55 16 arena=den left=43 right=58 hp=150 beginner
bosses/brute 55 16 arena=den left=43 right=58 hp=250 speed=3 enraged expert
