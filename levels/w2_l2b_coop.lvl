# Club & Grub - World 2, stage 2 (second half) in co-op: "Brute's Den" for two (designer DB2; DESIGN.md D.9, B.7).
# The co-op file of levels/w2_l2b.lvl (kind = coop, coop_of, coop_base_hash; never edit the solo file). The den and
# the Brute records are the solo ones (in a co-op game on this file the Brute takes its co-op form: hit points
# x5/4, the arm guard towards whoever hit it last - only the partner reaches its head; the Grab on Expert).
# Main-path gate 'den', with its x2 tablet and the checkpoint behind it: the end of the bone tunnel is a keeper
# hall 4 rows high, shut by a bone door. Its keepers are two bonded diggers - lizards dug into the bone dirt, one
# in the hall and one in the bone pit 9 rows under it (a shaft by the door leads down, a vine leads back up).
# Club one and the other comes back unless the partner clubs his within the window: one hero waits by the upper
# lizard, the other drops into the pit, the count-in plays and both strike. One hero alone is too slow for the
# window (about 38 ticks from one strike spot to the other; a special thrown at one member from anywhere leaves
# him 37+ ticks from the other).

[meta]
format = 2
id = w2_l2b_coop
name = "Brute's Den"
kind = coop
coop_of = w2_l2b
coop_base_hash = "e32f48b77815f8a8763ffcdf33278012fd81d0c5873777a3a1ee82235530286a"
book = 1
world = 2
stage = 2
biome = cave
terrain_a = cave/terrain_stone
terrain_b = cave/terrain
background = cave
music = level_cave
bonus_tier = 1
author = DB2
notes = "Co-op 2-2b: two bonded diggers keep the bone door (one in the hall, one in the pit under it); the co-op Brute in the den."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:44,heart,food:33 look=inset tile=#
k = objects/hidden_spot kind=small count=2 contents=food:36,food:29 tile=#
E = objects/exit locked=true
C = objects/checkpoint
a = items/food index=33
b = items/food index=46
Y = items/heart

