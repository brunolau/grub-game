#.@..S......$..K.B.p..J.....C.hoqwulcrbkg...G.......N.yF.E.#
#######?#*##################################################
############################################################
############################################################

[entities]
# A pillar of two cells rises out of the ground in front of the sign when the hero walks past the gate.
objects/column 49 11 size=2,1 rise=2 trigger=45,6,4,5
# Where the gate leads: up on the ledge with the treasures.
objects/marker 20 5 name=nook
