# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7, docs/LEVEL_DESIGN.md).
# World 3-2 'Crystal Grotto': the last level of a Beginner run (World 4 is expert only). Owner: level designer w3.
# Frost-blue rock (set A, grip) and glassy ice floors (set B, ice 2). The route enters the mountain, descends the
# crystal gallery (darts in the ceiling alcoves, the boomerang = swirling axe at its foot), crosses the leaper lake
# (leapers jump out of the icy water pits; the wide pool is crossed on hanging floes that drop when stood on),
# rides a dropping floe down the chasm into the lower gallery (glassy ice, a dart, a leaper pocket), climbs the
# crystal shaft and leaves through the skylight cave. Secrets: the side grotto by the boomerang (letter S), the
# crystal alcove of the lower gallery, and behind the cracked wall of the shaft the warp room to bonus stage C.

[meta]
format = 1
id = w3_l2
name = "Crystal Grotto"
kind = main
order = 60
world = 3
stage = 2
biome = ice
terrain_a = ice/terrain_rock
terrain_b = ice/terrain
ice_a = 0
ice_b = 2
liquid = ice_water
background = ice
music = level_grotto
password_beginner = "GR0T"
password_expert = "B00M"
bonus = bonus_c
bonus_tier = 1
author = w3
notes = "World 3-2: darts, leapers from icy water, drop floes, the boomerang, the warp to bonus stage C."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:34,food:32,food:31 tile=#
i = objects/hidden_spot kind=small count=3 contents=food:34,food:32,treasure:3 look=inset tile=#
* = objects/hidden_spot kind=big hits=3 contents=giant:5 tile=#
$ = objects/breakable_block hits=2 contents=food:15 tile=;
r = objects/hidden_spot kind=small count=2 contents=food:3,food:2 tile=#
C = objects/checkpoint
E = objects/exit
O = objects/drop_platform skin=ice delay=8
T = enemies/walker skin=turtle_b left=-3 right=3 hp=10
H = enemies/hopper skin=mini_rex_b range=6 hp=10
h = enemies/hopper skin=mini_rex_b range=6 hp=10 expert
D = enemies/dart skin=bat_b range=6 speed=3 hp=10
d = enemies/dart skin=pterodactyl_b range=7 speed=4 hp=10 expert
X = enemies/leaper skin=dragon_b pause=110 hp=10
x = enemies/leaper skin=dragon_b pause=70 hp=10 expert
A = enemies/dangler skin=bat_b depth=56 hp=10
f = items/food index=34
g = items/food index=32
k = items/food index=19
c = items/food index=31
j = items/treasure index=10
n = items/treasure index=15
t = items/treasure index=6

