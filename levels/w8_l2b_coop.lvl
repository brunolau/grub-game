# Club & Grub - World 8, stage 2b in co-op: "Idol Court" (designer D8). The co-op file of levels/w8_l2b.lvl
# (DESIGN.md A.6 / B.4 / D.10, LEVEL_DESIGN.md 15.7): the same approach and court with P2's start; the scarab
# of the approach is a leech (it rides a hero's back; only the partner clubs it off). The Twin Idols wake
# together in their co-op form, the Twin Hit: each idol is awake only while an active hero stands on its half of
# the court, and a hit on its open jaws cracks it only when the OTHER hero strikes its twin within the window
# (12 ticks on Expert). Eight cracks each (the co-op form sets it; no `hp` here). The sub-stage's co-op gate is
# the boss form (LEVEL_DESIGN.md 15.7.3).

[meta]
format = 2
id = w8_l2b_coop
name = "Idol Court"
kind = coop
coop_of = w8_l2b
coop_base_hash = "74a5eb23c0484d8a1d83f4e8b21276ec42bdd3bfa470c7814839682c5d4e5d97"
book = 2
world = 8
stage = 2
biome = ruins
terrain_a = ruins/terrain_carved
terrain_b = ruins/terrain
background = temple
music = level_idol_hall
min_difficulty = expert
bonus_tier = 2
author = D8

[legend]
C = objects/checkpoint
E = objects/exit locked=true
$ = objects/breakable_block tile=;

