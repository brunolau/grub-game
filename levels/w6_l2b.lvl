# Club & Grub - World 6, stage 2b: "Heart of the Mangrove" (designer D6, Book II "The Far Shore").
# Up the hollow trunk while the tar rises behind the hero (DESIGN.md A.3 / A.6 / B.2, difficulty 6; scroll = rising,
# 1 px per tick, 1.25 on Expert): root ledges three rows apart, vines, mangrove bugs, cave bats and a Puffcap per
# thirty rows; checkpoints every 28 rows (the tar restarts six rows under each); the Cave Painting (index 5) at the
# top of a side vine four cells off the climb. On the landing the rise stops (zones/autoscroll_stop), a checkpoint,
# then a hole into Old Mangrove's chamber (GAMEPLAY 13.6: 20 x 12, floor row 10, the Guardian in the right wall,
# root ledges at rows 7 and 5 [G35]), whose fire-starter opens the exit totem in its corner.

[meta]
format = 2
id = w6_l2b
name = "Heart of the Mangrove"
kind = sub
book = 2
world = 6
stage = 2
biome = swamp
terrain_a = swamp/terrain_bark
terrain_b = swamp/terrain
background = mangrove
music = level_mangrove_climb
liquid = tar
scroll = rising
rise_speed = 16
rise_speed.expert = 20
password_beginner = "R00T"
password_expert = "MNGR"
bonus_tier = 1
author = D6

[legend]
C = objects/checkpoint
E = objects/exit locked=true

