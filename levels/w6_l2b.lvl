[entities]
# the trunk: the sign, the vines, the painting's side vine and nook
objects/sign 8 117 text=SIGN_W6_TIDE
objects/vine 10 95 length=8
objects/vine 10 69 length=8
objects/vine 10 46 length=8
objects/vine 5 48 length=5
items/painting 3 47 index=5
zones/secret 3 47 name=root_nook rect=2,46,3,2
props/swamp/glowcaps 2 47
# enemies of the climb: mangrove bugs on the checkpoint ledges, cave bats beside the jump column, a Puffcap per
# thirty rows on a ledge end away from it
enemies/dangler 15 98 skin=cave_bat depth=24 hp=10
enemies/snapper 14 105 skin=puffcap range=30 hp=10
enemies/digger 5 88 skin=lizard zone=3,85,6,4 hp=10
enemies/dangler 4 82 skin=cave_bat depth=24 hp=10
enemies/snapper 14 79 skin=puffcap range=30 hp=10
