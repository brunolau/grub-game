# ---- co-op (DB1) ------------------------------------------------------------------------------------------------
objects/hero_start 4 38 slot=2
objects/sign 88 38 text=SIGN_COOP_W1_EGG
# Gate 1 "hop": the springy flower became a ledge 8 rows over the flat floor on both difficulties, its face where the
# old step stood (G2 integration: a Totem Ride on an idle partner plus the corner catch climbs 7 rows, and the old
# step beside the dip stood 6 rows under the ledge - world-B's search v2 reached it alone; LEVEL_DESIGN 15.7.2). One
# hero Shoulder-Hops off his partner's head; up top he clubs the coiled vine at the edge, it drops down and the
# partner climbs it (the gift). The far cell is 16 columns from the coil (a rolled vine counts as a booster within
# reach of the far cell).
objects/sign 97 38 text=SIGN_COOP_W1_HOP
objects/x2_tablet 100 38 gate=hop far=117,31
objects/vine 101 31 length=8 rolled
objects/sign 104 30 text=SIGN_COOP_W1_VINE
objects/checkpoint 135.5 33
# Gate 2 "plates" (the Great Tree on the canopy road, travelled leftwards): A holds plate pa, door D1 of the lower
# corridor opens and B walks through; B holds plate pb on the far side, door D2 of the upper corridor opens and A
# climbs the branch into it. The tablet stands by the top of the climb.
objects/x2_tablet 233 17 gate=plates far=196,17
objects/sign 219 17 text=SIGN_COOP_W1_PLATES
objects/plate 216 17 name=pa
objects/column 204 17 size=1,2 rise=2 rise_while=pa
objects/plate 200 17 name=pb
objects/column 210 13 size=1,2 rise=2 rise_while=pb
objects/checkpoint 194.5 17
# x2 secret: the High Cache over the far treetop - only a Totem rider's jump strike reaches it (painting 20).
objects/x2_tablet 197 17 secret far=193,17
objects/hidden_spot 193 9 kind=small count=1 contents=painting:20 prop=jungle/foliage_clump
# Two Shellback turtles guard the tree house (the exit): one hero in front, the other strikes the back.
objects/sign 178 16 text=SIGN_COOP_W1_SHELL
enemies/walker 162 18 skin=turtle_b left=0 right=0 speed=0 hp=10 coop=shell
enemies/walker 168 18 skin=turtle_b left=0 right=0 speed=0 hp=10 coop=shell
