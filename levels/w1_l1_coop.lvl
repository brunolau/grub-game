format = 2
id = w1_l1_coop
name = "Vine Bridges"
kind = coop
coop_of = w1_l1
coop_base_hash = "fa9e4c3774a3522d64fc7a15dc69ad88753ed44f30abcd6e7f312274d50ba421"
