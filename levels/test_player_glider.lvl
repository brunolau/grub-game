# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7). Developer level of the player module: a hang-glider
# pick-up, a long runway for the run-up, a wide valley to glide over (PHYSICS.md 13.2) and the exit on the far
# plateau. Used for autoplay screenshots of the hero; not part of the campaign.

[meta]
format = 1
id = test_player_glider
name = "Glider Run"
kind = test
biome = jungle
terrain_a = jungle/terrain_grass
terrain_b = jungle/terrain
background = jungle
music = level_jungle

[legend]
E = objects/exit locked=false
G = items/glider

