# Club & Grub - Feast Land A co-op: "Sky Picnic" for two (designer DB1; docs/expansion/DESIGN.md D.9, GAMEPLAY.md
# 13.9.8). The co-op file of levels/bonus_a.lvl (kind = coop, coop_of, coop_base_hash; never edit the solo file): the
# bonus stage of 1-2 (Canopy Village) entered through the warp of w1_l2_coop. A Feast Land in co-op has the team rules
# only - no x2 gate (DESIGN.md D.8 #1): the same sky playground, springs, cloud stair, ride and cake tower; P2 starts a
# cell behind P1; the giant roasts of the big spots pay for two when both heroes strike them within the window and
# bounce chains alternate to x12 (Relay Bounce; engine rules of GAMEPLAY.md 13.9.8). The spiral staff on the cake
# tower ends the stage (and its source level) for the tribe.

[meta]
format = 2
id = bonus_a_coop
name = "Feast Land A"
kind = coop
coop_of = bonus_a
coop_base_hash = "21e84043e2b222d902e8c5e665b339e9e18f199fa2ceaaf2a4149e534be09578"
book = 1
order = 0
world = 0
stage = 0
biome = feast
terrain_a = feast/terrain
terrain_b = feast/terrain_icing
background = feast
music = bonus
bonus_tier = 0
home_row = 15
author = DB1
notes = "Co-op Feast Land A (bonus of 1-2), team rules only. 45-90 s. Entered through the warp of w1_l2_coop."

