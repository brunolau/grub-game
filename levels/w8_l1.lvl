# Club & Grub - World 8, stage 1: "Overgrown Steps" (designer D8, Book II "The Far Shore"; Expert only).
# The Idol Ruins open with a temple stair in the jungle (DESIGN.md A.3 / A.6, difficulty 7): three stairs of
# rising columns on stone plates (the 1.0 trigger columns dressed as plates) - a plain stair up the first terrace,
# pillars out of a bronze spike pit (its plate up on a plinth) and a lift stair whose columns rise under the hero
# through the broken roof of the hall; Guards that turn their shields slowly; Mimics among real chests; a vine
# through a hole in the hall roof to the roof gallery, where Cave Painting 9 waits in a real chest between two
# Mimics. The swirling axe lies in a real chest at checkpoint 2; the feast kit is spread over the stage, its third
# piece before the summit. Nothing on the main path needs a special.

[meta]
format = 2
id = w8_l1
name = "Overgrown Steps"
kind = main
order = 140
book = 2
world = 8
stage = 1
biome = ruins
terrain_a = ruins/terrain
terrain_b = ruins/terrain_jade
background = ruins
music = level_ruins
liquid = water
min_difficulty = expert
password_expert = "STEP"
bonus_tier = 2
author = D8

[legend]
C = objects/checkpoint
E = objects/exit

