# Club & Grub - World 6, stage 2b for two: "Heart of the Mangrove" co-op (designer D6, Book II "The Far Shore").
# The solo trunk (w6_l2b) for a tribe of two (DESIGN.md A.6 / D.10, LEVEL_DESIGN.md 15.7): up the hollow trunk
# ahead of the rising tar, then the co-op Old Mangrove. Co-op gates:
#  - 'vent' (rows 68-74): the second vine of the solo climb is the vent room - two deadly tar vents side by side
#    (period 34, half a period apart) under a ceiling five rows up, so one hero is always inside a spout box on
#    the way across and the two boxes leave him no common gap; a heave boulder on the floor that only two heroes
#    push (the 3 cells of floor behind it, 5 rows of air) rolls 4 tiles onto both vents and plugs them, its top
#    flush with the step beyond. A checkpoint on the ledge below the room (the tar restarts 6 rows under it: the
#    push has its own spare) and one on the step behind it;
#  - the co-op Old Mangrove (B.2): the face and the resting hand struck by the two heroes within the twin window
#    (one rides the fist springboard to the face, the other strikes the hand from the root ledges), a hero standing
#    on the resting fist pins it, and in stage 3 the knuckle armour faces the nearer active hero. The lower root
#    ledge's last two cells are rotten bark (hatch tiles): crouch there to drop onto the wrist side of the stuck fist.
# Traits: lone mangrove bugs, a bonded Puffcap pair (8 columns and 9 rows apart: no thrown special from beside one
# crosses the other); no Snatcher (a grab on a rising climb would be a death trap).

[meta]
format = 2
id = w6_l2b_coop
name = "Heart of the Mangrove"
kind = coop
coop_of = w6_l2b
coop_base_hash = b4b051dc625e18b687a320b097d0e589334ae44771f586df79b3ff74c9574dc3
book = 2
world = 6
stage = 2
biome = swamp
terrain_a = swamp/terrain_bark
terrain_b = swamp/terrain
background = mangrove
music = level_mangrove_climb
liquid = tar
scroll = rising
rise_speed = 16
rise_speed.expert = 20
bonus_tier = 1
author = D6

[legend]
C = objects/checkpoint
E = objects/exit locked=true

