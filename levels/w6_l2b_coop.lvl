# Old Mangrove's chamber (B.2, G35): the arena (= the camera lock) is the 11 rows from the ceiling to the floor
# row - the locked view shows the floor row and 4 px under it, so the face sits as low in the view as the
# chamber allows; the record stands in the floor-level air cell left of the Guardian's bark wall; its default
# drop (the fire-starter) comes out on the floor in front of the trunk (BossBase._drop_origin)
zones/arena 27 23 name=chamber rect=20,14,20,11
bosses/mangrove 34 23 arena=chamber
props/swamp/vine_b 38 17 layer=front
props/swamp/moss_fringe 37 15 layer=front

