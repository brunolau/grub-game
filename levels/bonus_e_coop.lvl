# Club & Grub - Feast Land E in co-op: "Pudding Lagoon" (designer D7). The co-op file of levels/bonus_e.lvl
# (DESIGN.md A.6 / D.8 / D.10, LEVEL_DESIGN.md 15.7.3): the same lagoon with P2's start; a Feast Land in co-op has
# only the team exit (the warp home) - its co-op rules are the engine's (Relay Bounce on the jelly flyers, both
# heroes on the wafer rafts, which carry two). Traits: two of the four jelly flyers are `lone` (they keep away
# from a pair that stays together and dive at the straggler).

[meta]
format = 2
id = bonus_e_coop
name = "Feast Land E"
kind = coop
coop_of = bonus_e
coop_base_hash = "69843756871dc2207d2d915cd0be66b629b92e428a30e42aa94f0011dd01a3f7"
book = 2
order = 0
world = 0
stage = 0
biome = feast
terrain_a = feast/terrain_pudding
terrain_b = feast/terrain_biscuit
background = feast
music = bonus_lagoon
liquid = syrup
bonus_tier = 2
author = D7

[legend]
a = objects/hidden_spot kind=small count=3 contents=food:24,food:25,food:26 look=inset tile=#
b = objects/hidden_spot kind=small count=3 contents=food:27,food:28,treasure:2 look=inset tile=#
c = objects/hidden_spot kind=small count=3 contents=food:29,food:30,food:31 look=inset tile=%
d = objects/hidden_spot kind=small count=2 contents=treasure:4,food:32 look=inset tile=#
B = objects/hidden_spot kind=big hits=3 contents=giant:3 look=block tile=#
P = objects/hidden_spot kind=big hits=3 contents=painting:18 look=inset tile=#
C = objects/checkpoint

