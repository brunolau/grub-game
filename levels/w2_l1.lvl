# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7). World 2, stage 1: "Echo Caverns".
# A tall cave system: the Echo Gallery at the top (a turtle, a dangler, an optional high vein with the G, a gate
# to the crystal cache), the Hatch Well (four stacked chambers joined by hatches, lurkers on the ceilings, the
# HAMMER, a first pendulum bat), the Dark Deep (darkness, pendulum bats over a black lake, a gate to the bone
# vault) and the Echo Shaft that climbs back up to the exit. A breakable wall high in the shaft hides the warp
# to bonus stage B. Pendulum bats hang low under rock lips: crawl under them or club them.

[meta]
format = 1
id = w2_l1
name = "Echo Caverns"
kind = main
order = 30
world = 2
stage = 1
biome = cave
terrain_a = cave/terrain
terrain_b = cave/terrain_stone
liquid = water
background = cave
music = level_cave
password_beginner = "ECHO"
password_expert = "B4TS"
bonus = bonus_b
bonus_tier = 1
author = w2
notes = "World 2-1: hatches, danglers, lurkers, swingers, darkness, gates to secret rooms, the hammer, warp to bonus B."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:13,food:21,food:9 look=inset tile=#
* = objects/hidden_spot kind=big hits=3 contents=giant:3 look=block tile=#
$ = objects/breakable_block hits=2 tile=;
k = objects/hidden_spot kind=small count=2 contents=food:24,food:12 tile=#
K = objects/hidden_spot kind=small count=3 contents=food:27,treasure:4,food:31 tile=#
J = objects/hidden_spot kind=big hits=4 contents=giant:1 tile=#
n = objects/hidden_spot kind=small count=4 contents=food:22,food:30,food:23,treasure:7 tile=#
a = items/food index=2
b = items/food index=7
c = items/food index=14
d = items/food index=21
e = items/food index=33
f = items/food index=40
g = items/food index=41
h = items/food index=47
i = items/food index=43
t = items/treasure index=3
p = items/food index=31

