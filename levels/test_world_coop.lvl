# The co-op playground of world-A (PLAN.md P1.6): two heroes on the tribe camera (edge walls, leash), a 7-row ledge
# for the Shoulder Hop, a 5-row Totem ledge, a camera-lock room that pulls the partner in, a pit (a fall is an egg
# while the partner stands), a checkpoint (it hatches eggs) and the team exit. Developer level, kind = test;
# single-player ignores P2's start.

[meta]
format = 2
id = test_world_coop
name = "World Test: Tribe Playground"
kind = test
book = 2
biome = canyon
terrain_a = canyon/terrain
terrain_b = canyon/terrain_mesa
background = canyon
music = level_jungle

[legend]
C = objects/checkpoint
E = objects/exit
f = items/food index=3

