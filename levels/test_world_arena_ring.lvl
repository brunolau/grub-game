# Club & Grub level file - format 2. A developer copy of the Totem Ring sketch (docs/expansion/DESIGN.md E.5) for the
# referee's wrap tests: the floor and the wrap ledges continue across the left-right seam. Owner: world-B.

[meta]
format = 2
id = test_world_arena_ring
name = "Totem Ring (test)"
kind = arena
biome = jungle
terrain_a = jungle/terrain_grass
