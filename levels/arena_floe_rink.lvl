# Club & Grub level file - format 2 (docs/ARCHITECTURE.md 7.11). Versus arena #3 of docs/expansion/DESIGN.md E.5:
# Floe Rink - ice, open sides into icy water; an ice floor, two see-saw floes; sudden death: the Whiteout. Owner: DA
# (arenas, docs/expansion/PLAN.md 6.1). Rules: docs/LEVEL_DESIGN.md 15.8. Dressing: art-B's hand-over
# (.tools/asset_candidates/expansion/_handover/ARENA_DRESSING.md, "Floe Rink"; E.5 has no sketch, the geometry is DA's).
#
# Layout notes:
# - Open sides: the ice floor (row 10, cols 2-17, `ice_a = 1`: knock-backs slide) stops two cells short of each edge;
#   cols 0-1 / 18-19 are icy water (`~`, deadly). A knock-back near an edge is a ring-out.
# - The floes: two see-saws (objects/seesaw skin=floe len=4) with their fulcrums at cols 3 / 16 (the outer low end
#   reaches over the water's edge, the inner end is high). A hero who lands on the high end (a walk-off from the cloud
#   ledge above, 5 rows) flings whoever stands on the low end 150-170 px up (PHYSICS.md C.17) - over the water if he
#   was moving outward.
# - Tiers 3 rows apart: the floor (row 10), the central floe (row 7, cols 8-11, one-way rock with the big spot), the
#   upper ice ledges (row 4, cols 3-7 / 12-16, one-way).
# - Spots (visible, refill 15 s after they are emptied): one in the floor by each spawn (cols 7 / 12), one flush in
#   each upper ledge's outer end (cols 3 / 16), and the big spot in the central floe (col 9; col 10 beside it is plain
#   rock, so it is struck alike from either half - the hit test reaches one column). Its giant falls 7 rows onto it.
# - Cookpots: two (4-player arena), on the upper ledges' inner ends (cols 7 / 12).
# - Spawns (rotate every round; 2 players use 1 and 2): 1 and 2 on the floor (cols 13 / 6), 3 and 4 on the upper
#   ledges (cols 5 / 14).
# - Modes: Last Caveman Standing (default), Grub Stack, Hot Rock; each needs a green bot set in core-B's
#   tests/test_versus_bots.gd.
# - Bot graph: resources/bots/arena_floe_rink.json, baked with core-B's tool after every edit of this file:
#   bash .tools/gd.sh script res://tools/bots/bake_nav.gd -- arena_floe_rink

[meta]
format = 2
id = arena_floe_rink
name = "Floe Rink"
kind = arena
biome = ice
terrain_a = ice/terrain
terrain_b = ice/terrain_rock
ice_a = 1
background = ice
liquid = ice_water
music = versus_battle_c
players = 4
modes = last_caveman,grub_stack,hot_rock
round_time = 90
wrap = none
sudden = whiteout
author = DA
notes = "Versus arena 3 (DESIGN.md E.5): ice, open sides into icy water; a slippery floor, two see-saw floes at the edges, the central floe with the big spot, upper ice ledges; the whiteout's gusts in sudden death."

[legend]
? = objects/hidden_spot kind=small count=3 look=block tile=#
s = objects/hidden_spot kind=small count=3 look=block tile=%
* = objects/hidden_spot kind=big look=inset tile=%
L = objects/seesaw len=4 skin=floe facing=r
R = objects/seesaw len=4 skin=floe facing=l
P = objects/cookpot
Q = objects/cookpot
B = objects/spawn_point index=2
C = objects/spawn_point index=3
D = objects/spawn_point index=4

[tiles]
....................
....................
....................
.....C.P....Q.D.....
...s====....====s...
....................
....................
........=*%=........
....................
...L..B......@..R...
~~#####?####?#####~~
~~################~~

[entities]
props/ice/icicle 7 5 layer=back
props/ice/icicle 12 5 layer=back
props/ice/crystal_ice_a 5 9 layer=back
props/ice/crystal_ice_b 14 9 layer=back
props/ice/rocks_small 9 9 layer=back
props/ice/tusk_a 4 3 layer=back
props/ice/tusk_b 15 3 layer=back
props/ice/sprouts 10 6 layer=back
