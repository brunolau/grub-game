# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7).
# Feast Land B "Tower of Treats": the bonus stage of 2-1 (Echo Caverns). A tall cake tower climbed from the
# ground floor to the crown: springs throw the hero up through biscuit floors past fountains of ice cream, an icing
# stair climbs to a ceiling spot, an elevator rises through a waterfall of waffles, springs and ledges reach the
# candy spiral, and the spiral staff (items/warp) waits on the crown. No enemies; every floor catches a fall.
# Optional: the pantry hidden in the thick right wall (secret), spots in every storey, the candy spiral.

[meta]
format = 1
id = bonus_b
name = "Feast Land B"
kind = bonus
order = 0
world = 0
stage = 0
biome = feast
terrain_a = feast/terrain_icing
terrain_b = feast/terrain_biscuit
background = feast
music = bonus
bonus_tier = 1
author = feast
notes = "Bonus stage B, entered from w2_l1 (meta bonus = bonus_b). 45-90 s. No level codes: only the warp leads here."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:15,food:16,food:17 look=inset tile=%
* = objects/hidden_spot kind=big hits=3 contents=giant:6 look=block tile=%
Q = objects/hidden_spot kind=small count=2 contents=food:20,food:21 tile=%
Y = objects/hidden_spot kind=small count=2 contents=food:20,treasure:6 look=inset tile=#
R = objects/hidden_spot kind=small count=3 contents=food:31,food:38,food:31 tile=%
V = objects/hidden_spot kind=small count=3 contents=food:31,treasure:10,food:38 look=inset tile=#
B = objects/hidden_spot kind=big hits=4 contents=giant:4 tile=%
U = objects/hidden_spot kind=small count=3 contents=food:29,food:30,treasure:4 prop=village/flower_pot
K = objects/container skin=barrel contents=food:38,food:37,food:31
$ = objects/breakable_block hits=2 contents=food:16 tile=;
J = objects/spring
P = objects/platform dir=0 speed=2 travel=80 mode=ride
W = items/warp
a = items/food index=15
b = items/food index=16
c = items/food index=17
d = items/food index=20
e = items/food index=21
g = items/food index=19
h = items/food index=31
k = items/food index=38
r = items/food index=2
s = items/food index=3
w = items/food index=30
x = items/treasure index=14
t = items/treasure index=8
m = items/giant_bonus index=2
n = items/giant_bonus index=3

