# Club & Grub - World 7, stage 2b: "Squid Grotto" (designer D7, Book II "The Far Shore").
# The second half of the Sea Caves and the last Beginner stage (DESIGN.md A.3 / A.6 / B.3, difficulty 7): a short
# approach - behind the start a breakable wall hides the Cave Painting (index 8); driftwood floes over the grotto
# water under an octopus; checkpoint and sign on the ledge; steps up to the hole in the grotto roof - then the drop
# into the one-screen grotto of Inkjaw, the Grotto Squid, exactly as GAMEPLAY.md 13.6: deadly water across the
# floor, rock islands at arena columns 2-5, 8-11 and 14-17 (surface row 9 of the 11-row lock), one-way root ledges
# at row 6 over the two gaps it surfaces in. The squid coughs up the fire-starter; the exit totem stands locked on
# the right island. Clearing it ends a Beginner run (the expert wall). Nothing needs a special.

[meta]
format = 2
id = w7_l2b
name = "Squid Grotto"
kind = sub
book = 2
world = 7
stage = 2
biome = coast
terrain_a = coast/terrain_cave
terrain_b = coast/terrain
background = sea_cave
music = level_sea_caves
liquid = water
password_beginner = "SQU1"
password_expert = "JAWZ"
bonus_tier = 1
author = D7

[legend]
o = objects/drop_platform skin=driftwood delay=10
C = objects/checkpoint

