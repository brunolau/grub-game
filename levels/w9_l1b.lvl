# Club & Grub - World 9, stage 1b: "Thunderhead Glide" (designer D9a, Book II "The Far Shore").
# The second half of Cloudbreak Climb (difficulty 8, Expert only; DESIGN.md A.2 / A.3 / A.6): a hang-glider crossing
# through a thunderstorm between the spire's first summit and the Roc's Spire. The glider lies on a slate runway
# (24 ticks at speed to take off); lightning marks a hero's column 22 ticks before the bolt (zones/lightning,
# period 66) over both crossings, never over a landing cloud; storm pterodactyls harry the glider (a dive from above
# scores the 1 000 / 5 000 / 10 000 ladder); cloud stacks with steam geysers are thermals for a glider that sank too
# low. Checkpoint 2 on the landing cloud in the middle, with a second glider. The Cave Painting (index 13) on a high
# cloud over the second crossing that only a glider climbing on lift reaches. The exit totem on the far slate ledge.

[meta]
format = 2
id = w9_l1b
name = "Thunderhead Glide"
kind = sub
book = 2
world = 9
stage = 1
biome = sky
terrain_a = sky/terrain_rock
terrain_b = sky/terrain
background = storm
music = level_storm_glide
min_difficulty = expert
password_expert = "ST0R"
bonus_tier = 2
author = D9a

[legend]

