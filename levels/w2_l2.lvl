# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7). World 2, stage 2 (first half): "Bone Gorge".
# Out of the caves onto the rim of a giant gorge full of old bones: diggers burst out of the bone dirt, stepping
# stones rise out of a spike pit as the hero goes, a pillar lifts him up a cliff and a stone slab rises to bridge
# a gap. At the end of the upper terrace lies the HANG-GLIDER: a long runway, then the glide over the Bone Gorge
# itself, where bats and pterodactyls patrol below the glide line (dive on them: 1 000 / 5 000 / 10 000). The
# exit on the far rim leads straight into the sub-stage w2_l2b (the Brute) without a tally.
# Authored with a generator; positions are (column, row) of 16 px cells.

[meta]
format = 1
id = w2_l2
name = "Bone Gorge"
kind = main
order = 40
world = 2
stage = 2
biome = cave
terrain_a = cave/terrain_stone
terrain_b = cave/terrain
liquid = water
background = cave
music = level_cave
password_beginner = "B0NE"
password_expert = "GL1D"
next = w2_l2b
tally = false
bonus_tier = 1
author = w2
notes = "World 2-2a: diggers, rising columns (stepping stones, lift, bridge), the hang-glider over the Bone Gorge; continues in w2_l2b."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:13,food:22,food:9 look=inset tile=#
* = objects/hidden_spot kind=big hits=3 contents=giant:4 look=block tile=#
$ = objects/breakable_block hits=2 tile=;
k = objects/hidden_spot kind=small count=2 contents=food:24,food:12 tile=#
K = objects/hidden_spot kind=small count=3 contents=food:27,treasure:4,food:31 tile=#
n = objects/hidden_spot kind=small count=4 contents=food:22,food:30,food:23,treasure:7 tile=#
J = objects/hidden_spot kind=big hits=4 contents=giant:2 tile=#
a = items/food index=0
b = items/food index=8
c = items/food index=13
d = items/food index=20
e = items/food index=44
f = items/food index=36
g = items/food index=41
h = items/food index=45
t = items/treasure index=1

