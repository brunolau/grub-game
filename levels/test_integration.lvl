# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7).
# Integration level: a compact jungle level that uses every system of the game once - slopes, one-way platforms,
# water, a checkpoint, every hidden-spot kind, containers, a spring, moving and dropping platforms, spikes,
# food and treasure, the axe, eight enemies of seven archetypes, a canopy secret, flies over dirty cave ground
# and the exit in a lower cavern.
# Together with test_integration_boss it forms the development campaign (kind = main): debug builds can play
# title -> map -> level -> tally -> boss -> ending; exports exclude levels/test_*.lvl.

[meta]
format = 1
id = test_integration
name = "Integration Meadow"
kind = test
next = test_integration_boss
world = 1
stage = 1
biome = jungle
terrain_a = jungle/terrain_grass
terrain_b = jungle/terrain
background = jungle
music = level_jungle
password_beginner = "MEAD"
password_expert = "W1LD"
bonus_tier = 0
author = integrator
notes = "Development pair, level 1 (kind test since the real campaign exists; next leads to the boss pit): every system of the game in one walk (whole-loop autoplay QA)."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:4,food:9,treasure:2 look=inset tile=#
* = objects/hidden_spot kind=big hits=3 contents=giant:1 look=block tile=#
$ = objects/breakable_block hits=2 contents=food:20 tile=;
S = objects/hidden_spot kind=small count=2 contents=food:30,treasure:5 prop=jungle/rock_grass
K = objects/container skin=crate contents=food:5,food:12
R = objects/container skin=barrel contents=heart,food:30
J = objects/spring
C = objects/checkpoint
E = objects/exit
P = objects/platform dir=2 speed=2 travel=30 mode=ride
D = objects/drop_platform delay=12
W = items/weapon kind=axe
f = items/food index=3
g = items/food index=17
h = items/food index=26
t = items/treasure index=6
m = items/treasure index=11
u = items/letter index=0
x = items/treasure index=14
q = items/water_bucket
T = enemies/walker skin=turtle left=-3 right=3 hp=10
H = enemies/hopper skin=mini_rex range=6 hp=10
N = enemies/snapper skin=plant range=42 hp=10
B = enemies/flyer skin=bat left=-3 right=3 hp=10
A = enemies/dangler skin=bat_b depth=48 hp=10
I = enemies/stinger skin=insect range=5 hp=10
L = enemies/lurker skin=insect_b range=4 hp=10
X = enemies/leaper skin=dragon hp=10

