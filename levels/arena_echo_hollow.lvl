props/cave/stalactite 16 0 layer=back
props/cave/drips 9 0 layer=back
props/cave/crystal_violet_a 1 6 layer=back
props/cave/crystal_cyan_b 18 6 layer=back
props/cave/drip_cap 5 8 layer=back
props/cave/drip_cap 14 8 layer=back
props/cave/mushrooms 6 9 layer=back
props/cave/rocks_small 13 9 layer=back
props/cave/skull_buried 4 9 layer=back
props/cave/crystal_cyan_d 15 9 layer=back
