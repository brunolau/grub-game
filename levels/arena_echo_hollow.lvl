# Club & Grub level file - format 2 (docs/ARCHITECTURE.md 7.11). Versus arena #2 of docs/expansion/DESIGN.md E.5:
# Echo Hollow - cave, a shaft that wraps top-bottom; sudden death: the cave-in. Owner: DA (arenas,
# docs/expansion/PLAN.md 6.1). Rules: docs/LEVEL_DESIGN.md 15.8. Dressing: art-B's hand-over
# (.tools/asset_candidates/expansion/_handover/ARENA_DRESSING.md, "Echo Hollow"; E.5 has no sketch, the geometry is
# DA's on art-B's proposal).
#
# Layout notes:
# - The shaft: the floor (row 10) has a 4-cell hole (cols 8-11) over nothing - the bottom row is the seam (wrap = tb),
#   so a hero who walks or is knocked into it comes in at the top and lands on the central ledge (row 7, cols 8-11)
#   right above it: the hole is the quick way up. Rising past the top (a stomp bounce off a head on an upper ledge)
#   comes in at the bottom, where every floor lets feet through from below (PHYSICS.md 11.2: floors are one-way).
# - Tiers 3 rows apart: the floor (row 10), the side shelves (row 7, cols 0-3 / 16-19) and the central ledge (row 7,
#   cols 8-11), the upper ledges (row 4, cols 3-7 / 12-16, over the gaps between the shelves and the central ledge).
#   Every ledge is one-way; nothing stands higher than row 4, so a plain jump never reaches the top seam.
# - Spots (8 cells, visible, refill 15 s after they are emptied): one in the floor under each shelf (cols 2 / 17), one
#   flush in each shelf's wall end (cols 0 / 19), one flush in each upper ledge's outer end (cols 3 / 16), and the big
#   spot: two big-spot cells side by side in the middle of the central ledge (cols 9 / 10, the E.5 sketches' `**`) -
#   each counts its own 3 hits, the first one used up drops the giant over itself and opens its twin (the flood fill:
#   one giant per refill). Its giant falls 7 rows onto the ledge over the hole.
# - Cookpots: two (4-player arena), on the upper ledges' inner halves (cols 6 / 13).
# - Spawns (rotate every round; 2 players use 1 and 2): 1 and 2 on the floor between the shelves and the hole (cols
#   14 / 5), 3 and 4 on the shelves (cols 1 / 18).
# - The darkness pulse (DESIGN.md E.5 / G43, world-B's referee): `dark_pulse = 486` - from round tick 486 on, the
#   first 73 ticks of every 486 (20 s) are night (heroes glow; the 22-tick fade is the telegraph). It changes only the
#   picture: the bot sets with it are tick-identical to those without it.
# - Modes: Hot Rock (default), Grub Stack, Last Caveman Standing; each has a green bot set in core-B's
#   tests/test_versus_bots.gd (12 seeds x 4 rounds, four Hunters). Phase 3: the symmetric big spot (two cells) took
#   Grub Stack from 15 points worst (one cell in col 9: the left floor spawn led; in col 10 the right one did) to 8;
#   Hot Rock 8, LCS 12 (re-measured with the darkness pulse, same numbers).
# - Dropped from 2.0 (PLAN.md cut 3 as applied in wf10, the orchestrator's decision): the `$` walls that grow back
#   (`regrow`) and the dangler springboard (`enemies/dangler`, world-B's neutral springboard) - they broke spawn
#   fairness. Every placement measured in phase 3 put the right floor spawn ahead in Grub Stack (48-58 % of 48
#   rounds): `$` columns under the side shelves (cols 3 / 16, rows 8-9), with or without the dangler over the shaft
#   (x 160, rows 1-3), and the dangler alone; spawns one cell in or out did not even it out (variants and numbers:
#   build/engine_requests/wf9_da_to_lead_design.txt). The arena's signature is the darkness pulse alone.
# - Bot graph: resources/bots/arena_echo_hollow.json, baked with core-B's tool after every edit of this file:
#   bash .tools/gd.sh script res://tools/bots/bake_nav.gd -- arena_echo_hollow

[meta]
format = 2
id = arena_echo_hollow
name = "Echo Hollow"
kind = arena
biome = cave
terrain_a = cave/terrain
terrain_b = cave/terrain_stone
background = cave
music = versus_battle_b
players = 4
modes = hot_rock,grub_stack,last_caveman
round_time = 90
wrap = tb
sudden = cave_in
dark_pulse = 486
author = DA
notes = "Versus arena 2 (DESIGN.md E.5): cave, wrap top-bottom; the hole in the floor drops onto the central ledge from the top, shelves and upper ledges 3 rows apart, the big spot over the hole; a darkness pulse every 20 s; cave-in in sudden death."

[legend]
? = objects/hidden_spot kind=small count=3 look=block tile=#
s = objects/hidden_spot kind=small count=3 look=block tile=%
* = objects/hidden_spot kind=big look=inset tile=%
P = objects/cookpot
Q = objects/cookpot
B = objects/spawn_point index=2
C = objects/spawn_point index=3
D = objects/spawn_point index=4

[tiles]
....................
....................
....................
......P......Q......
...s====....====s...
....................
.C................D.
s===....=**=....===s
....................
.....B........@.....
##?#####....#####?##
########....########

