# Club & Grub - World 5, stage 2 in co-op: "Rattlesnake Gulch" (designer D5). The co-op file of levels/w5_l2.lvl
# (DESIGN.md D.10, LEVEL_DESIGN.md 15.7): the same gulch with P2's start and two co-op gates on the main path, each with
# its tablet and a checkpoint behind:
#  - 'sandgate' (bands B / C): a vertical leapfrog. One hero holds plate pa on band B: the sand gate D1 rises and his
#    partner walks through it into the dead end under band C, where he holds plate pb: the gate D2 at the top of the
#    vine rises; the first hero climbs the vine (one climbs while the other holds the gate open) and walks through D2,
#    then strikes the rolled vine down into the dead end - the gift: the partner climbs it into band C. An idle
#    partner on pa lets a lone player into the dead end, never through D2;
#  - 'rattlers' (band E): the two rattlers in the hall under the roof are bonded keepers of its door: one hero clubs
#    each, both inside one window (the hall is 4 rows high: nobody hops over a rattler).
# The tortoises carry the shell trait; the Expert tortoise of band B walks behind the mesa block right of checkpoint 1
# instead of in the dead end.
[meta]
format = 2
id = w5_l2_coop
name = "Rattlesnake Gulch"
kind = coop
coop_of = w5_l2
coop_base_hash = "93160dd3ff43d9d85d5fe41a948dd2d4974f5aef9bc08a340f91cfaf1fdcfcdf"
tally = false
bonus = bonus_d
book = 2
world = 5
stage = 2
biome = canyon
terrain_a = canyon/terrain
terrain_b = canyon/terrain_mesa
background = canyon
music = level_gulch
liquid = water
bonus_tier = 1
author = D5

[legend]
K = objects/bark_board face=l tile=%
a = objects/hidden_spot kind=small count=3 contents=food:3,food:7,food:11 look=inset tile=#
b = objects/hidden_spot kind=small count=2 contents=food:13,treasure:4 tile=#

