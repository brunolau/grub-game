# Club & Grub - World 3, stage 1 in co-op: "Frost Summit" for two (designer DB2; docs/expansion/DESIGN.md D.9).
# The co-op file of levels/w3_l1.lvl (kind = coop, coop_of, coop_base_hash; never edit the solo file). Main-path
# gates, each with its x2 tablet and a checkpoint behind it:
#  - 'lake': the rock island of the frozen lake became an ice tunnel 4 rows high with a Bull Rex inside (a heavy,
#    hp 100) and an ice door at its far end that opens when the rex is dead. Its front glances: two heroes crouching
#    side by side on the slippery ice (a Brace Wall) stop it dead and daze it with its head open.
#  - 'cliff': the cliff climb ends at a rock step 8 rows under the clifftop: a Shoulder Hop gets one hero up, and
#    he clubs the coiled vine at the edge down for his partner (the gift).
# x2 secret: the ice cave under the lake (a hatch on the near shore; the far-shore lid is frozen shut): a
# plate holds an ice door open while the partner fetches the cave painting (24) and the U. Shellback turtles on
# the hill, in the valley and on the ridge; two ridge chargers are a bonded pair (one rushes down from the rock
# shelf, its twin waits on the ridge under it); the other chargers and the summit hoppers are loners (Expert).

[meta]
format = 2
id = w3_l1_coop
name = "Frost Summit"
kind = coop
coop_of = w3_l1
coop_base_hash = "50bc346ea1cad952bf241a1f14807986b6bf83d82a2806d38c97711164e5cb88"
book = 1
world = 3
stage = 1
biome = ice
terrain_a = ice/terrain
terrain_b = ice/terrain_rock
ice_a = 1
ice_b = 0
liquid = ice_water
background = ice
music = level_ice
next = w3_l1b
tally = false
bonus_tier = 1
author = DB2
notes = "Co-op 3-1a: a Bull Rex in the ice tunnel on the frozen lake (Brace Wall, keeper door), the Shoulder Hop step at the cliff top with a rolled vine, the x2 ice cave (plate door, painting 24)."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:18,food:19,food:16 tile=#
q = objects/hidden_spot kind=small count=3 contents=food:46,food:41,treasure:1 tile=%
i = objects/hidden_spot kind=small count=3 contents=food:19,food:18,food:16 look=inset tile=#
* = objects/hidden_spot kind=big hits=3 contents=giant:4 tile=#
w = objects/hidden_spot kind=big hits=4 contents=giant:2 tile=%
$ = objects/breakable_block hits=2 contents=food:15 tile=;
C = objects/checkpoint
E = objects/exit
T = enemies/walker skin=turtle_b left=0 right=0 speed=0 hp=10 coop=shell
H = enemies/hopper skin=mini_rex_b range=6 hp=10
h = enemies/hopper skin=mini_rex_b range=6 hp=10 expert coop=lone
R = enemies/charger skin=rival hp=10 coop=lone
X = enemies/charger skin=rex_b hp=30 expert
f = items/food index=16
g = items/food index=18
k = items/food index=19
c = items/food index=15
m = items/food index=46
d = items/food index=41
t = items/treasure index=1
j = items/treasure index=9
n = items/treasure index=13
Y = enemies/charger skin=rival hp=10 coop=bond bond=ridge

