# Gate 'cliff': the rock step 8 rows under the clifftop; the coiled vine at the clifftop's edge (its coil 12 cells
# from the far cell) hangs down to the step.
objects/sign 118 35 text=SIGN_COOP_W3_HOP
objects/x2_tablet 120 35 gate=cliff far=134,27
objects/vine 122 28 length=8 rolled=true
# x2 secret, the ice cave: a hatch over the shaft on the near shore (crouch to drop in); a vine hangs in the shaft
# from the shore line (its top step lands on the shore: the way out); the plate (cols 80-81) holds the ice door (col 89)
# open while the partner fetches the painting and the U in the nook behind it.
objects/vine 49 54 length=10
objects/x2_tablet 75 63 gate=icecave secret far=94,63
objects/plate 80 63 name=ic
objects/column 89 63 size=1,5 rise=5 rise_while=ic
items/painting 94 63 index=24
items/letter 92 63 index=2
items/treasure 96 63 index=6
objects/sign 70 63 text=SIGN_COOP_W3_CAVE
# The ridge chargers: a bonded pair, one on the rock shelf and one on the ridge 6 rows under it.
enemies/charger 199 23 skin=rival hp=10 coop=bond bond=ridge

