# ---- co-op (DB2) ----------------------------------------------------------------------------------------------
# P2 starts beside P1.
objects/hero_start 5 53 slot=2
# Gate 'lake': the Bull Rex in the ice tunnel (hp 100: a lone hero would need four hits on its back, each one a hurt);
# the ice door opens when it is dead (keepers).
objects/sign 70 51 text=SIGN_COOP_W3_BRACE
objects/x2_tablet 76 49 gate=lake far=98,53
enemies/bull_rex 89 50 hp=100 keeper=lake
