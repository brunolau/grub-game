objects/hero_start 3 37 slot=2
# Gate "plates" (DESIGN.md D.9 4-2): the leapfrog wall across the great hall. Plate pa (11 cells before door D1
# at the far end of the lower corridor) opens the lower corridor; plate pb behind the wall (10 cells from door D2
# at the near end of the upper corridor) opens the upper one, whose mouth the slabs over pa climb to. The plates
# are 14 cells apart: both heroes stay on one view.
objects/sign 55 37 text=SIGN_COOP_W4_PLATES
objects/x2_tablet 57 37 gate=plates far=86,37
objects/plate 67 37 name=pa
objects/column 78 37 size=1,3 rise=3 rise_while=pa
objects/plate 81 37 name=pb
objects/column 71 31 size=1,3 rise=3 rise_while=pb
# Gate "drums": the spiked portcullis of the ramparts (its door block cols 156-157, rows 23-26, rises 4 rows into
# the gate tower once its twin drums are struck within the window: drum A on the ledge by the
# portcullis, 4 rows over the rampart, drum B by the keep tower: no throw line from beside one crosses the other).
objects/sign 149 26 text=SIGN_COOP_W4_DRUMS
objects/x2_tablet 152 26 gate=drums far=160,26
