# Club & Grub - Feast Land D: "Honey Falls" (designer D5, Book II "The Far Shore"), the bonus stage of 5-2.
# Food-made and enemy-light like Feast Lands A-C (DESIGN.md A.2 / A.3, GAMEPLAY.md 13.2): honey floors (`:` - the tar
# rules in a candy skin, `liquid = honey`), soda geysers that lift the hero onto comb cliffs, and honeycomb walls full
# of spots. A sign teaches the honey before its first pool and another the soda vent before the first geyser; a comb
# mound with a big spot on top, the comb cliff with a second honey pool, the honey falls stepping down to the floor,
# a side tower whose geyser leads to the Cave Painting (index 17) in a nook behind a breakable wall, and the spiral
# staff (items/warp) on its stand, which ends the stage and its source level. No enemies, no pits.
[meta]
format = 2
id = bonus_d
name = "Feast Land D"
kind = bonus
book = 2
order = 0
world = 0
stage = 0
biome = feast
terrain_a = feast/terrain_honeycomb
terrain_b = feast/terrain
background = feast
music = bonus
liquid = honey
bonus_tier = 1
author = D5
notes = "Bonus stage D, entered from w5_l2 (meta bonus = bonus_d). 45-90 s. No level codes: only the warp leads here."

[legend]
a = objects/hidden_spot kind=small count=3 contents=food:24,food:25,food:26 look=inset tile=#
b = objects/hidden_spot kind=small count=2 contents=treasure:1,food:27 tile=#
c = objects/hidden_spot kind=small count=3 contents=food:28,food:29,treasure:3 look=inset tile=#
B = objects/hidden_spot kind=big hits=3 contents=giant:2 look=block tile=#

