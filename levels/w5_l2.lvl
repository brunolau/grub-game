# Club & Grub - World 5, stage 2: "Rattlesnake Gulch" (designer D5, Book II "The Far Shore").
# A vertical gulch (difficulty 4, DESIGN.md A.2 / A.3): six bands of canyon floor stacked 12-14 rows apart, joined by
# vines that hang through holes in the rock (a sign teaches the vine before the first one). The way zigzags up:
# band A (right) - B (left, checkpoint 1, burrow snakes) - C (left, a rolled vine over band B: strike it on the way
# and it is the short way up after a fall) - D (right, checkpoint 2, the letter G on a ledge; at its far end a mesa
# pillar 8 rows high with two bark boards 3 rows apart on its face: the Feast Land D warp on top, reached only by two
# spear steps - optional, the spear comes from 5-1 on the belt) - E (left, checkpoint 3, a low hall under a roof
# with two rattlers, entered through the roof; the Cave Painting (index 1) at the top of a side vine) - F (right) to
# the exit totem, which leads on to Tusker's Wallow. Rattlers in burrows, burrow snakes, cave bats; more of them on Expert.
[meta]
format = 2
id = w5_l2
name = "Rattlesnake Gulch"
kind = main
order = 115
tally = false
next = w5_l2b
bonus = bonus_d
book = 2
world = 5
stage = 2
biome = canyon
terrain_a = canyon/terrain
terrain_b = canyon/terrain_mesa
background = canyon
music = level_gulch
liquid = water
password_beginner = "R4TL"
password_expert = "V1NZ"
bonus_tier = 1
author = D5

[legend]
K = objects/bark_board face=l tile=%
a = objects/hidden_spot kind=small count=3 contents=food:3,food:7,food:11 look=inset tile=#
b = objects/hidden_spot kind=small count=2 contents=food:13,treasure:4 tile=#

