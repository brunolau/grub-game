# Club & Grub - World 8, stage 2: "Hall of Idols" (designer D8, Book II "The Far Shore"; Expert only).
# The original's gate-and-secret-room craft inside the temple (DESIGN.md A.3 / A.6, difficulty 8): one-screen rooms
# joined by arches (Down on an arch goes through; every room has an arch back), bronze spike pits, a dark crypt lit by
# braziers, and Guards in halls four rows high that nobody can bounce over - each hall has a niche in its ceiling: wait
# on the hatch until the Guard walks under you with its shield turned away, drop behind it and strike its back.
# Three secret rooms: a hole behind the start, the Cave Painting room (index 10) behind a breakable wall of the
# crypt - the room behind the third gate - and a hidden arch in the long gallery. The exit leads to the Idol Court.

[meta]
format = 2
id = w8_l2
name = "Hall of Idols"
kind = main
order = 145
book = 2
world = 8
stage = 2
biome = ruins
terrain_a = ruins/terrain
terrain_b = ruins/terrain_carved
background = temple
music = level_idol_hall
liquid = water
min_difficulty = expert
password_expert = "1D0L"
next = w8_l2b
tally = false
bonus_tier = 2
author = D8

[legend]
C = objects/checkpoint
E = objects/exit
$ = objects/breakable_block tile=;

