# Club & Grub - World 5, stage 2b: "Tusker's Wallow" (designer D5, Book II "The Far Shore").
# The second half of Rattlesnake Gulch (difficulty 4, DESIGN.md A.2 / A.3 / B.1, GAMEPLAY.md 13.6): a short approach
# along the canyon floor past a sand hump and a red mesa - the Cave Painting (index 2) waits in a chamber inside the
# mesa behind a breakable wall - a rattler and a tortoise, the checkpoint and the sign, then a shaft drops into the
# walled pit of Tusker, the Boar King: mesa banks 3 rows up in both corners (3 cells each), a 4-cell mud wallow (`:`)
# in the middle of the pit floor and a rock ceiling the phase-3 rocks fall from (the arena of the boss owner's
# levels/test_enemies_tusker.lvl, so the 76 px boar has dry floor to charge on). The boar drops the fire-starter; the
# exit totem stands locked on the right bank. Nothing needs a special.
[meta]
format = 2
id = w5_l2b_coop
name = "Tusker's Wallow"
kind = coop
coop_of = w5_l2b
coop_base_hash = "48c6ce2c645b508dd4238234dc5e6592238571c1cff63ed6f292c69fe42a472b"
book = 2
world = 5
stage = 2
biome = canyon
terrain_a = canyon/terrain
terrain_b = canyon/terrain_mesa
background = canyon
music = level_gulch
liquid = water
bonus_tier = 1
author = D5

