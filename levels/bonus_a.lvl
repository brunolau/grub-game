I = objects/hidden_spot kind=small count=2 contents=food:29,food:30 look=inset tile=%
T = objects/hidden_spot kind=small count=3 contents=food:38,treasure:9,food:38 look=inset tile=#
S = objects/hidden_spot kind=small count=4 contents=food:20,food:21,food:19,treasure:3 prop=jungle/bush_light
$ = objects/breakable_block hits=2 contents=food:16 tile=;
J = objects/spring
K = objects/spring power=-288
P = objects/platform dir=2 speed=2 travel=96 mode=ride
W = items/warp
a = items/food index=15
