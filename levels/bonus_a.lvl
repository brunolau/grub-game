# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7).
# Feast Land A "Sky Picnic": the bonus stage of 1-2 (Canopy Village). An open sky playground over a sponge-cake
# meadow: springs throw the hero up to icing clouds, a cloud stair climbs to a cake island, a ride crosses to the
# icing island, a waterfall of sweets falls back to the meadow and a big spring launches him onto the cake tower
# with the spiral staff (items/warp) that ends the stage and its source level. No enemies, no pits: the meadow
# catches every fall. Optional: the cloud pantry in the top-left (secret) and the spring garden under the ride.

[meta]
format = 1
id = bonus_a
name = "Feast Land A"
kind = bonus
order = 0
world = 0
stage = 0
biome = feast
terrain_a = feast/terrain
terrain_b = feast/terrain_icing
background = feast
music = bonus
bonus_tier = 0
home_row = 15
author = feast
notes = "Bonus stage A, entered from w1_l2 (meta bonus = bonus_a). 45-90 s. No level codes: only the warp leads here."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:15,food:16,food:17 look=inset tile=#
* = objects/hidden_spot kind=big hits=3 contents=giant:2 look=block tile=#
