# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7).
# Feast Land C "Candy Road": the bonus stage of 3-2 (Crystal Grotto). A speed run along a long biscuit causeway:
# gaps to jump with candy arcs over them, cake hills, a big spring that launches the hero over a wide gap along an
# arc of cake slices, slippery icing hills, a crumbling biscuit bridge to run across without stopping, a candy
# fountain, three giant treats and the spiral staff (items/warp) on its podium at the far end. The chocolate cellar
# under the causeway catches every fall; springs throw the hero back up. No enemies.
# Optional: the gate in the cellar leads to the hidden sugar room (secret).

[meta]
format = 1
id = bonus_c
name = "Feast Land C"
kind = bonus
order = 0
world = 0
stage = 0
biome = feast
terrain_a = feast/terrain_biscuit
terrain_b = feast/terrain_icing
ice_b = 1
background = feast
music = bonus
bonus_tier = 2
author = feast
notes = "Bonus stage C, entered from w3_l2 (meta bonus = bonus_c). 45-90 s. No level codes: only the warp leads here."

[legend]
