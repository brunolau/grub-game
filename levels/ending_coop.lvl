# Club & Grub - Ending "Way Home" for two (designer DB3; docs/expansion/DESIGN.md D.9, LEVEL_DESIGN.md 15.7).
# The co-op file of levels/ending.lvl (kind = coop, coop_of, coop_base_hash; never edit the solo file): the calm walk
# home after the Wall Colossus, for two. Its one co-op gate, "lookout": the village gate is barred - a rock wall
# across the road whose gate rises only while the latch plate up on the lookout gallery has been stepped on. The
# gallery juts from the wall 8 rows over the road (LEVEL_DESIGN.md 15.7.3: a boost ledge, 8 rows over every floor
# within reach): one hero stands under its end, the other Shoulder-Hops off his head onto it, steps on the plate
# (the gate rises and stays up) and drops back down to the road. The gallery is also the x2 secret: Cave Painting
# 29 waits at its far end, by the watch hut. No enemies, no hazards; the exit totem in front of the hut is the
# team exit. Expert only, as the solo stage.

[meta]
format = 2
id = ending_coop
name = "Way Home"
kind = coop
coop_of = ending
coop_base_hash = "34503b1fc7072580910a6f97838aeedf6a25f9e66fdaac577bf665e30570190b"
book = 1
order = 0
world = 0
stage = 0
biome = village
terrain_a = jungle/terrain_grass
terrain_b = feast/terrain_biscuit
background = jungle
music = ending
min_difficulty = expert
bonus_tier = 2
author = DB3
notes = "Co-op epilogue after w4_l2b_coop: the lookout gate (Shoulder Hop onto the gallery, latch plate), painting 29, team exit."

