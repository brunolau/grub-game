# ---- co-op (DB1) ------------------------------------------------------------------------------------------------
objects/hero_start 2 105 slot=2
# Gate 1 "treehouse" (a boost ledge since wf10): the tree house deck is 8 rows over the root mound under its face
# (no lift, no snapper; the mound's top two rows are gone). One hero lands on his partner's head holding Up (the
# Shoulder Hop) or jumps just after him from his head (the Totem launch of the sign); up top he clubs the coiled vine
# at the deck's edge (its coil 13 cells from the far cell) and it unrolls down to the mound for his partner. It was a
# 6-row Totem ledge: a lone hero's hop jump (a jump begun in a low strike's hop, a high strike on the way) lifts his
# feet 82 px, 2 px into that ledge's corner catch (DB1's probes, build/db1/p6/logs/tree_lowhighL.log) - 8 rows leave
# 30 px. The coil is safe from below by the coil rule of DESIGN G67 (a hit from its own level only). A checkpoint on
# the forest floor.
objects/checkpoint 31 105
objects/sign 29 105 text=SIGN_COOP_W1_TOTEM
objects/x2_tablet 33 105 gate=treehouse far=27,93
objects/vine 40 94 length=8 rolled
# Specials in pairs: a second axe floats over the tree house deck (a jump takes it).
items/weapon 31 90 kind=axe
# Gate 2 "shaft" (wf10 redesign of the pulley, which no pair could play with the tribe camera: a 7-row counterweight
# put the partners 14 rows apart and the rising pan left the view; nor could anyone leave its ledge, 2 rows under the
# trunk top): the shaft's ledge (row 38, cols 47-48) is 8 rows over its floor - a boost ledge: one hero lands on his
# partner's head holding Up (the Shoulder Hop, 140 px) or is launched from a Totem Ride. Up there he crouches on the
# plate of the ledge's right cell: the stone under the shaft's right side (cols 49-50) rises 8 rows while he holds it
# and lifts his partner to the ledge (the plate 9 tiles from its stone). Both climb the vine that hangs from the
# shaft's mouth to the trunk top; its foot ends 16 px over the ledge (9 rows over the floor: a grab from the floor
# would need the feet 112 px up). A checkpoint on the deck before it, one on the trunk top behind it.
# No rolled vine here and nothing to club or bounce on in the shaft (a lone hero's feet rise 73-80 px with a jump
# begun in a strike's hop and 114 px with a club pogo off a floor spot - DB1's probes, build/db1/p6): the trunk
# room's inset spot (code stone 1, treasure 11) moved from the shaft floor (46,46) to the big branch (53,36), and the
# solo file's pterodactyl (enemies/harrier at 32,36, over the twigs left of the deck) is left out (LEVEL_DESIGN
# 15.7.1 #4 / G22: no record that hands a lone hero a bounce at a height gate) - once woken it circles its target
# through scenery, into the shaft too, and a head bounce with Up rises 105 px (probe: 220 px over the shaft floor).
objects/checkpoint 39 45
objects/sign 41 45 text=SIGN_COOP_W1_SHAFT
# The tablet's far cell lies on the village deck beyond the big branch (reached only over the trunk top), so the
# gate's box of the solo search (tablet and far cell grown by 10 x 6 cells) holds this gate's plate and stone but
# not the Snatcher over the branch or the drums of 'nest', which are no part of it (G59).
objects/x2_tablet 48 45 gate=shaft far=64,47
objects/plate 48 37 name=shaft w=1
objects/column 49 46 size=2,1 rise=8 rise_while=shaft
objects/sign 45 45 text=SIGN_COOP_W1_LIFT
objects/vine 47 30 length=7
# The Feast Land A warp waits in a cage in the crow's nest: its door rises when both drums of 'nest' are struck
# within the window (one on the trunk top, one on the big branch, 5 columns and 6 rows apart, on no throw line of
# the other: G36). The bat over the trunk top still bounces a hero up to the nest, where the tablet stands by the cage
# door.
objects/sign 48 29 text=SIGN_COOP_W1_DRUMS
objects/x2_tablet 49 21 gate=nest far=44,21
objects/drum 51 29 bond=nest
objects/drum 56 35 bond=nest
objects/column 45 21 size=1,2 rise=2 trigger=drums:nest
# Leapers of the lower right deck: one in each pit (wf10: no longer bonded - a leaper is a spawner whose record never
# dies, so a bond of leapers could never seal and its copies regrew for ever; the deck is crossed in their pauses).
enemies/leaper 67 73 skin=dragon hp=10
enemies/leaper 73 73 skin=dragon hp=10
# The Snatcher bat over the big branch: it seizes a hero who touches it from below and carries him to the branch's
# end (perch) - the partner frees him with any hit.
enemies/snatcher 63 30 kind=dangler depth=64 hp=10 perch=73,35
# x2 secret: the treetop cache, 8 rows over the village deck - a charged Batter Up lob (crouch to charge the club,
# then the high strike) lands the ball on it: Cave Painting 21.
objects/x2_tablet 87 47 secret far=92,39
items/painting 93 39 index=21

