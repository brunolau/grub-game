# Club & Grub - World 7, stage 2: "Sea Caves" (designer D7, Book II "The Far Shore").
# Into the coast cave (DESIGN.md A.3 / A.6, difficulty 6): the cave mouth with sea snails and a cave bat;
# checkpoint 1 and the sign, then the first driftwood crossing - floes over the sea water that sink a moment after
# you land, an octopus lurking on the ceiling over the line; the second crossing under octopi on kelp threads;
# checkpoint 2 on the drift-log ledge, where letter S sits on a rock shelf a blowhole (or two spear steps up the
# drift-log stack) reaches; the shaft down into the dark half (glow anemones and crystal coral mark the way);
# checkpoint 3 on the shore of the dark lake, floes to a rock islet - the Cave Painting (index 7) at the top of the
# kelp vine in the shaft above it - and on to the far shore; checkpoint 4 and the climb back up to the light and
# the exit into the grotto (7-2b). Nothing on the main path needs a special.

[meta]
format = 2
id = w7_l2
name = "Sea Caves"
kind = main
order = 135
book = 2
world = 7
stage = 2
biome = coast
terrain_a = coast/terrain_cave
terrain_b = coast/terrain
background = sea_cave
music = level_sea_caves
liquid = water
tally = false
next = w7_l2b
password_beginner = "KELP"
password_expert = "1NKY"
bonus_tier = 1
author = D7

[legend]
o = objects/drop_platform skin=driftwood delay=10
G = objects/geyser skin=blowhole period=88
K = objects/bark_board face=r tile=%
C = objects/checkpoint
E = objects/exit

