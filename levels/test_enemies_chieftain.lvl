[entities]
zones/arena 9 10 name=pyre rect=0,0,20,12 music=boss_chieftains
bosses/chieftain 6 10 name=gorm mate=gulla arena=pyre
bosses/chieftain 9 4 name=gulla mate=gorm arena=pyre drops=trophy
