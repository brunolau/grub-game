# Old Mangrove's Test Chamber: developer level of enemies-B (PLAN.md P2.2) - the chamber of Old Mangrove, the Rooted
# Guardian (DESIGN.md B.2) for tests/test_enemies_mangrove.gd: the club route of the solo form, the fairness checks
# and the single-hero search against the co-op form (the test loads this file with `form=coop` on the boss and a
# second hero at the objects/hero_start marker). The trophy it drops is the level's exit for the validator.
# One screen: floor row 10, the Guardian's bark wall from column 15, one-way root ledges on the left at rows 7 and 5
# (the upper hand rests on the end of the row 5 ledge; a hero on the row 7 ledge reaches it with a high strike). The
# arena locks 11 rows (the floor on the view's last row, as w6_l2b frames its chamber), so the face and the resting
# hand stay clear of the fight HUD (DESIGN.md G35 as corrected).

[meta]
format = 2
id = test_enemies_mangrove
name = "Old Mangrove's Test Chamber"
kind = test
book = 2
biome = swamp
terrain_a = swamp/terrain
terrain_b = swamp/terrain_bark
background = swamp
music = level_fen
liquid = tar
author = enemies-B

[legend]

[tiles]
