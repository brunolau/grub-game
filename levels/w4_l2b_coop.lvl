# Club & Grub - World 4, stage 2b co-op: "Colossus Hall" for two (designer DB3; docs/expansion/DESIGN.md B.7 / D.9,
# LEVEL_DESIGN.md 15.7). The co-op file of levels/w4_l2b.lvl (kind = coop, coop_of, coop_base_hash; never edit the
# solo file): the antechamber and the hall of the Wall Colossus, for two. The co-op form comes by itself in a co-op
# game on a co-op file (scripts/bosses/colossus.gd, enemies-C): hit points 30, a stone visor over its face, lifted
# only while an active hero stands on the plate whose chain glows - the left-most and the right-most objects/plate
# of the hall - and only the OTHER hero's thrown weapon counts; every rage moves the live chain to the other plate,
# so the roles swap. Thrown weapons only, as in 1.0: the checkpoint holds two axes, one for each hero. The slab of
# the hall became a rock ledge two rows high between the plates: the thrower stands on it (rolling rocks turn at
# its faces), the holder hops the rocks spat at him and the drops rattle over the thrower. The arena
# lock is the 1.0 one (11 rows, the floor on its last row), which keeps the face clear of the fight HUD (G35).
# Expert only, as the solo stage. Its trophy leads to the Way Home (ending_coop in a co-op campaign).

[meta]
format = 2
id = w4_l2b_coop
name = "Colossus Hall"
kind = coop
coop_of = w4_l2b
coop_base_hash = "b3fea03bfd658ec8cc257fb38c503ae501890d319291eeba1af47e9cb228e7f1"
book = 1
world = 4
stage = 2
biome = volcano
terrain_a = volcano/terrain_obsidian
terrain_b = volcano/terrain
liquid = lava
background = volcano_shaft
music = level_volcano
min_difficulty = expert
next = ending
bonus_tier = 2
author = DB3
notes = "Co-op 4-2b: the visor Colossus (B.7) - two chain plates in the hall, two axes at the checkpoint."

[legend]
C = objects/checkpoint

[tiles]
##############################################
##############################################
#...................##########################
#.....................########################
