# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7, docs/LEVEL_DESIGN.md).
# World 3-1 'Frost Summit', first half (the blizzard half is w3_l1b). Owner: level designer w3.
# Snow on ice is slippery (ice_a = 1); the frost-blue rock (set B) grips. The route climbs from the foothills over a
# frozen lake (rock floes first, then ice floes), up a cliff face of floating rock ledges, along a ridge where
# chargers rush down from the ledges above, to the summit cave that leads into the blizzard.
# Secrets: the ice cave under the lake (break the ice blocks at the shore, or come up through the lid on the far
# shore), the room inside the cliff (break the wall at the sixth ledge), the sky ledges above the icicle overhang and
# the spire above the summit cave.

[meta]
format = 1
id = w3_l1
name = "Frost Summit"
kind = main
order = 50
world = 3
stage = 1
biome = ice
terrain_a = ice/terrain
terrain_b = ice/terrain_rock
ice_a = 1
ice_b = 0
liquid = ice_water
background = ice
music = level_ice
password_beginner = "SN0W"
password_expert = "YET1"
next = w3_l1b
tally = false
bonus_tier = 1
author = w3
notes = "World 3-1 first half: slippery foothills, frozen lake, cliff climb, charger ridge, summit cave."

[legend]
? = objects/hidden_spot kind=small count=3 contents=food:18,food:19,food:16 tile=#
q = objects/hidden_spot kind=small count=3 contents=food:46,food:41,treasure:1 tile=%
i = objects/hidden_spot kind=small count=3 contents=food:19,food:18,food:16 look=inset tile=#
* = objects/hidden_spot kind=big hits=3 contents=giant:4 tile=#
w = objects/hidden_spot kind=big hits=4 contents=giant:2 tile=%
$ = objects/breakable_block hits=2 contents=food:15 tile=;
