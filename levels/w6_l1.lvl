# Club & Grub - World 6, stage 1: "Bubbling Fen" (designer D6, Book II "The Far Shore").
# The Tar Fen opens slower and stickier (DESIGN.md A.3 / A.6, difficulty 5): the landing shore teaches tar (wade
# and tap-jump; a one-row step out of the first field, then a tar pit walled two rows high with a vine as the way
# out); the raft reach (a log raft drifts on a slow current over open tar, then must be paddled with forward
# strikes); checkpoint 1; a mangrove root deck over the path where the hammer lies on a jetty and a side raft drifts
# to a stump whose block wall hides the Cave Painting (index 3); checkpoint 2 and wild Chomper pacing before a rock
# fall (three head bounces in a row tame him; a two-row stump starts the chain); the tar flats he crosses at full
# speed (passable on foot, slowly), letter R on a stump over them; checkpoint 3, the water bucket and a gnat
# thicket to the exit totem. Nothing on the main path needs a special or Chomper.

[meta]
format = 2
id = w6_l1
name = "Bubbling Fen"
kind = main
order = 120
book = 2
world = 6
stage = 1
biome = swamp
terrain_a = swamp/terrain
terrain_b = swamp/terrain_bark
background = swamp
music = level_fen
liquid = tar
password_beginner = "FENS"
password_expert = "T4R5"
bonus_tier = 1
author = D6

[legend]
V = objects/vine length=3
W = objects/vine length=7
T = objects/raft width=3 skin=log tile=~
C = objects/checkpoint
E = objects/exit

