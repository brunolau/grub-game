# Club & Grub - World 7, stage 1 in co-op: "Shell Beach" (designer D7). The co-op file of levels/w7_l1.lvl
# (DESIGN.md A.6 / D.10, LEVEL_DESIGN.md 15.7): the same coast with P2's start, a pair of axes on bar 1, log rafts
# for two (4 cells) and two co-op gates on the main path, each with its tablet and a checkpoint behind:
#  - 'dune' (DESIGN A.6's named fallback of the "urchins" Chomper gate): leapfrog plate doors - the urchin beds
#    and Chomper's pen give way to a dune ten rows high with two corridors; plate A before it holds the lower
#    corridor's door for the partner, plate B beyond it holds the upper corridor's door (reached by two coral
#    shelves) for the holder; each plate 8+ tiles from its door;
#  - 'stack': a Batter Up lob - the sea-stack shoulder stands 7 rows over the 3-row rock (10 over the beach) and
#    the rock's blowhole is gone: one hero curls on the rock, the other lobs him up with a high strike; up there
#    he clubs the rolled vine at the edge, which unrolls down to the rock - the way up for the batter (its coil and
#    the warp stack's blowhole 11+ cells from the far cell).
# Traits: the tortoises are Shellbacks (shell), the gulls `lone`; no bonded pairs (G36: one thrown special crosses
# the fish pools in one line). Left out of the solo file: the leaping fish and the gulls over the raft reaches
# (they knock a paddler off his raft), the gull and
# the tortoise on the shoulder (a bounce for a lone hero at the lob ledge), the urchin beds' snail
# and gull.

[meta]
format = 2
id = w7_l1_coop
name = "Shell Beach"
kind = coop
coop_of = w7_l1
coop_base_hash = "8acbc9e32b9450904d68e720557490a10a0417787f5b996bd1729a7703f112e5"
book = 2
world = 7
stage = 1
biome = coast
terrain_a = coast/terrain_sand
terrain_b = coast/terrain
background = coast
music = level_coast
liquid = water
bonus = bonus_e
bonus_tier = 1
author = D7

[legend]
G = objects/geyser skin=blowhole period=88
K =objects/bark_board face=r tile=%
C = objects/checkpoint
E = objects/exit

