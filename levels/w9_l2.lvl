# Club & Grub - World 9, stage 2: "The Roc's Spire" (designer D9a, Book II "The Far Shore").
# The exam of the Sky Spire (difficulty 9, Expert only; DESIGN.md A.2 / A.3 / A.6): along the spire's shoulder to
# the Roc's nest in five sections, a checkpoint before each. Alternating gusts (wind_loop 352: a lull of 110 ticks,
# a gust to the left for 66, a lull, a gust to the right) over gaps of deadly tar - crouch to stand firm, jump in
# the lull. (A) the shoulder with two gust gaps and a Guard; (B) crumbling drop clouds over a tar lake with a slate
# stack to crouch on; (C) a tar pocket and the Guards of the slate terraces; (D) the Roller valley and two gust gaps
# round a cloud bridge; (E) the last gust gap, the Cave Painting (index 14) in a big spot in the cloud over the path,
# the cloud hall with a tribesman and the final gap over two drop clouds to the exit totem (on to Storm Nest). The
# world's feast kit lies in (B) and (C), the third piece before the Guards of the upper terrace.

[meta]
format = 2
id = w9_l2
name = "The Roc's Spire"
kind = main
order = 155
tally = false
next = w9_l2b
book = 2
world = 9
stage = 2
biome = sky
terrain_a = sky/terrain_rock
terrain_b = sky/terrain
background = storm
music = level_spire
liquid = tar
min_difficulty = expert
wind = 0:0,110:112,176:0,286:-112
wind_loop = 352
password_expert = "SP1R"
bonus_tier = 2
author = D9a

[legend]
T = objects/hidden_spot kind=big hits=3 contents=painting:14 look=inset tile=%

