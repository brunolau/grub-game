# Club & Grub - World 6, stage 2 in co-op: "Spore Hollow" (designer D6). The co-op file of levels/w6_l2.lvl
# (DESIGN.md A.6 / D.10, LEVEL_DESIGN.md 15.7): the same cave with P2's start and two co-op gates, each with its
# tablet and a checkpoint behind:
#  - 'seesaw': the entrance hall's spring cap now only reaches a cap ledge over a mushroom see-saw; the upper
#    passage lies 9 rows over the plank's low end. One hero drops from the cap ledge onto the high end and
#    throws his partner up; up there the partner strikes the rolled vine at the edge, the way up for the dropper;
#  - 'caps': two twin drums of glowing caps in the lower hall, 16 cells and 7 rows apart (the high one on a cap
#    ledge a spring cap reaches; out of every thrown special's flight line), open the stalk door when both are
#    struck inside the window.
# Traits: the mangrove bugs and eight mosquitoes are `lone` (Expert). DESIGN's bonded Puffcap pairs are left out: no
# pair inside one view lies out of every thrown special's flight line on these floors. The lower hall's frog and
# Puffcap moved east of the drums.

[meta]
format = 2
id = w6_l2_coop
name = "Spore Hollow"
kind = coop
coop_of = w6_l2
coop_base_hash = "201e6910c4b6e9b9cabba49ff2e0b2c19f1e3d761efd78e379381b5d66adaf19"
book = 2
world = 6
stage = 2
biome = swamp
terrain_a = swamp/terrain_mushroom
terrain_b = swamp/terrain
background = mushroom
music = level_spore
liquid = tar
dark = true
tally = false
next = w6_l2b
bonus_tier = 1
author = D6

[legend]
C = objects/checkpoint
E = objects/exit
S = objects/spring
G = objects/geyser period=88 skin=steam
H = objects/geyser period=88 delay=44 skin=steam
P = objects/drop_platform skin=small
B = objects/hidden_spot kind=big hits=3 contents=painting:4 look=inset tile=#
a = objects/hidden_spot kind=small count=3 contents=food:2,food:9,food:15 look=inset tile=#
b = objects/hidden_spot kind=small count=2 contents=food:21,treasure:4 tile=#

