# co-op gate 'seesaw' (DESIGN.md A.6): the cap ledge, the mushroom see-saw, the rolled vine (the gift)
objects/hero_start 3 51 slot=2
# wf11 (the explorer of DESIGN G77): from the cap ledge a lone hero jumped until his feet were level with the
# passage and threw a special at the coil in that moment - the coil rule [G67] asks only where the thrower's feet
# are. The hall's rock now reaches over the cap ledge (columns 20-27, down to 3 rows over the ledge): under it
# nobody's feet rise above y 720 (the rule asks for 704); the cap still lands him on the ledge, the see-saw's
# flight (columns 28-32) is as it was.
objects/x2_tablet 14 51 gate=seesaw far=44,42
objects/sign 16 51 text=SIGN_W6_COOP_SEESAW
objects/seesaw 28 51 len=5 facing=l skin=mushroom
objects/vine 32 43 length=8 rolled=true
props/swamp/glowcaps 34 42
