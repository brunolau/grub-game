# Club & Grub - World 7, stage 1: "Shell Beach" (designer D7, Book II "The Far Shore").
# The Coral Coast opens with a breather after the swamp (DESIGN.md A.3 / A.6, difficulty 5): a drift-log stack
# with two bark boards behind the landing beach (the Cave Painting, index 6, two spear steps up); three raft
# reaches on the surf currents between sand bars (each raft rests in still water at its bank: one backward strike
# paddles it into the current), the axe on a driftwood ledge over the first bar; checkpoint 1 and a blowhole that
# throws the hero onto a sea stack, a second blowhole up to letter B on a sea arch; the long reach with leaping fish
# and gulls; checkpoint 2 and the fish pools; checkpoint 3, Chomper's pen before the urchin beds (he walks over
# them; on foot they are jumped); checkpoint 4, the feast kit and the tallest sea stack, an arch over the beach
# (its blowhole throws the hero to a kelp vine that climbs to the Feast Land E warp on top); a strong blowhole on
# a 3-row rock throws him onto the sea-stack shoulder, 10 rows over the beach, and the exit totem stands on it.
# Nothing on the main path needs a special or Chomper.

[meta]
format = 2
id = w7_l1
name = "Shell Beach"
kind = main
order = 130
book = 2
world = 7
stage = 1
biome = coast
terrain_a = coast/terrain_sand
terrain_b = coast/terrain
background = coast
music = level_coast
liquid = water
password_beginner = "SHEL"
password_expert = "SURF"
bonus = bonus_e
bonus_tier = 1
author = D7

[legend]
T = objects/raft width=3 skin=log tile=~
G = objects/geyser skin=blowhole period=88
H = objects/geyser skin=blowhole period=88 power=-256
K =objects/bark_board face=r tile=%
C = objects/checkpoint
E = objects/exit

