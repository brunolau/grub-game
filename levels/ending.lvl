# Club & Grub level file - format 1 (docs/ARCHITECTURE.md 7).
# Ending "Way Home": the calm playable epilogue after the Wall Colossus (4-2, Expert). The hero walks home through
# the fields and the village gate, lights the campfires on his way (checkpoints), passes the welcome feast with the
# giant roast in the square, climbs the home hill and reaches the exit totem in front of his hut; the exit leads to
# the tally and The End. No enemies, no hazards; fruit, roast meat, barrels and pots to club for fun. Villagers
# (objects/npc) greet him: a guard at the watchtower, an elder and a kid at the feast fire, a kid and an elder at home.

[meta]
format = 1
id = ending
name = "Way Home"
kind = ending
order = 0
world = 0
stage = 0
biome = village
terrain_a = jungle/terrain_grass
terrain_b = feast/terrain_biscuit
background = jungle
music = ending
password_expert = "HUT5"
min_difficulty = expert
bonus_tier = 2
author = feast
notes = "Epilogue after w4_l2 (whose trophy leads here through its meta next). Exit -> tally -> The End. Expert only, so only an Expert code."

