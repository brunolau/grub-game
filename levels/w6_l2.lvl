# Club & Grub - World 6, stage 2: "Spore Hollow" (designer D6, Book II "The Far Shore").
# A mushroom cave in near darkness (DESIGN.md A.3 / A.6, difficulty 5): glowing caps mark the way and are springs
# (the sign before the first one), spore geysers throw the hero and the drop platforms resting on their vents up to
# the shelves (the sign before the first one), Puffcaps bite from the dark behind their glowing wind-up, cave bats
# drop on their threads, frogs and mangrove bugs. The world's feast kit lies in the middle third, its third piece
# before the densest Puffcap and bat stretch; letter U on a shelf a geyser-lifted platform reaches; the Cave
# Painting (index 4) in the big spot of the darkest side chamber up a spring cap off the path, marked by a lone
# big glowcap. Four checkpoints; the exit leads into the Heart of the Mangrove (w6_l2b) without a tally.

[meta]
format = 2
id = w6_l2
name = "Spore Hollow"
kind = main
order = 125
book = 2
world = 6
stage = 2
biome = swamp
terrain_a = swamp/terrain_mushroom
terrain_b = swamp/terrain
background = mushroom
music = level_spore
liquid = tar
dark = true
tally = false
next = w6_l2b
password_beginner = "SP0R"
password_expert = "GL0W"
bonus_tier = 1
author = D6

[legend]
C = objects/checkpoint
E = objects/exit
S = objects/spring
G = objects/geyser period=88 skin=steam
H = objects/geyser period=88 delay=44 skin=steam
P = objects/drop_platform skin=small
B = objects/hidden_spot kind=big hits=3 contents=painting:4 look=inset tile=#
a = objects/hidden_spot kind=small count=3 contents=food:2,food:9,food:15 look=inset tile=#
b = objects/hidden_spot kind=small count=2 contents=food:21,treasure:4 tile=#

