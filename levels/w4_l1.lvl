[entities]
# Crater throat: a boulder by the start hides a snack
objects/hidden_spot 13 6 kind=small count=3 contents=food:43,food:45,food:33 prop=volcano/rock_big
# Teaching sign under the start: the view only starts to sink once the player moves (Level, autoscroll).
objects/sign 16.5 6 text=SIGN_W4_SHAFT
# Digger gallery 1
enemies/digger 8 31 skin=lizard_b zone=1,27,15,5
# More of the shaft's dwellers (review fresh_eyes: the finale had the fewest enemies of the game): a turtle on the
# gallery floor, stingers hovering in the chimneys. Placed so that every weapon's route keeps its timing.
enemies/walker 12 31 skin=turtle_b left=-3 right=3 hp=25
enemies/stinger 8 14 skin=insect_b range=3 hp=20
enemies/stinger 9 102 skin=insect_b range=3 hp=20
enemies/stinger 14 125 skin=insect_b range=4 hp=20
objects/hidden_spot 13 31 kind=small count=3 contents=food:35,food:43,treasure:2 prop=volcano/skull_big
# Lava strata: an obsidian raft crosses the wide pool when the hero steps on it
objects/platform 8.5 46 dir=2 speed=3 travel=21 mode=ride skin=stone
enemies/leaper 5.5 55 skin=dragon pause=88
# Ember chute
zones/ember_rain 9 74 rect=1,64,18,22 period=28
# A hint as the hero enters the first ember rain (review fresh_eyes: the rain started unannounced).
zones/message 9 65 rect=1,62,18,5 text=SIGN_W4_EMBERS
enemies/stinger 17 77 skin=insect_b range=4 hp=20
objects/hidden_spot 5 74 kind=small count=3 contents=food:46,food:41,food:45 prop=volcano/bone_big
# Hatch band: the gate to the Cinder Cache
objects/gate 16 85 name=v1_door dest=v1_in skin=hole
# Digger gallery 2
enemies/digger 8 93 skin=lizard_b zone=1,89,13,5
objects/marker 2 93 name=v1_back
# Spike strata: the niche behind the breakable wall
zones/secret 17 111 name=u_niche rect=17,110,2,2
# Obsidian cavern: zigzag ledges under the ember rain; the vault door hides behind a breakable wall
zones/ember_rain 9 138 rect=1,120,18,34 period=30
objects/hidden_spot 15 134 kind=small count=3 contents=food:33,food:43,treasure:6 prop=volcano/skull_ribs
objects/gate 17 152 name=v2_door dest=v2_in skin=hole
# Lava gallery
enemies/leaper 14 160 skin=dragon pause=110
objects/marker 2 159 name=v2_back
# Magma chamber: the descent stops here
zones/autoscroll_stop 9 169 rect=1,163,18,8
enemies/leaper 11 171 skin=dragon pause=66
enemies/leaper 6 171 skin=dragon pause=88
# Vault 1: the Cinder Cache (gate on the hatch band)
zones/secret 35 91 name=cinder_cache rect=27,83,18,9
objects/gate 28 91 name=v1_in dest=v1_back lock=26,82 skin=hole
items/letter 43 91 index=3
items/treasure 33 88 index=8
items/treasure 39 85 index=14
items/code_stone 33 91 index=0
items/code_stone 36 91 index=1
items/food 38 91 index=40
items/food 40 91 index=35
objects/hidden_spot 42 92 kind=big hits=3 contents=giant:0 tile=# look=block
# Vault 2: the Ember Hoard (gate behind the breakable wall at the bottom of the cavern)
zones/secret 35 152 name=ember_hoard rect=27,144,18,9
objects/gate 28 152 name=v2_in dest=v2_back lock=26,143 skin=hole
items/treasure 36 146 index=15
items/treasure 31 149 index=10
items/treasure 41 149 index=12
items/code_stone 38 152 index=2
items/code_stone 40 152 index=3
items/one_up 36 152
