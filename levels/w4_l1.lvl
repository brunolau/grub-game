# Cinder Shaft (world 4, stage 1): an auto-scrolling descent down a volcanic chimney. Expert only.
# The view sinks one pixel per tick: keep up with it (the top edge kills) but never drop below the bottom edge.
# Embers rain in the open chimneys, diggers burrow out of the galleries, lava waits at the bottom. Two vaults
# hide behind gates (columns 26-45, single-screen rooms).
[meta]
format = 1
id = w4_l1
name = "Cinder Shaft"
kind = main
order = 70
world = 4
stage = 1
biome = volcano
terrain_a = volcano/terrain
terrain_b = volcano/terrain_obsidian
liquid = lava
background = volcano_shaft
music = level_shaft
scroll = autoscroll
min_difficulty = expert
password_expert = "4SHF"

[legend]
j = items/food index=42
f = items/food index=47
g = items/food index=41
h = items/food index=45
b = items/food index=46
k = items/food index=33
n = items/food index=43
m = items/food index=40
t = items/treasure index=4
C = objects/checkpoint
E = objects/exit
H = items/heart
G = items/letter index=0
R = items/letter index=1
U = items/letter index=2
S = items/letter index=4
Q = objects/hidden_spot kind=small count=3 look=inset tile=# contents=food:40,food:35,treasure:1

