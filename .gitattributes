# Normalise all text to LF so diffs and Godot's own writers agree on every platform.
* text=auto eol=lf

*.gd        text eol=lf
*.gdshader  text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.import    text eol=lf
*.lvl       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.py        text eol=lf
*.txt       text eol=lf

*.png   binary
*.ogg   binary
*.wav   binary
*.ttf   binary
*.otf   binary
*.ico   binary
*.icns  binary
*.res   binary
*.scn   binary
*.pck   binary
*.zip   binary
