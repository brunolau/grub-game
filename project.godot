; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters
;
; Club & Grub - binding settings are explained in docs/ARCHITECTURE.md section 2.
; Owner: core module. Other modules must not edit this file (ARCHITECTURE.md 1).

config_version=5

[application]

config/name="Club & Grub"
config/name.macos="Club and Grub"
config/description="Original prehistoric 2D platformer: club the scenery, grab the grub."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=0
boot_splash/bg_color=Color(0.152941, 0.12549, 0.0941176, 1)
boot_splash/show_image=true
boot_splash/stretch_mode=1
boot_splash/use_filter=false
boot_splash/image="res://assets/splash.png"
config/icon="res://assets/icon.png"
config/auto_accept_quit=false
config/quit_on_go_back=false
config/use_custom_user_dir=true
config/custom_user_dir_name="ClubAndGrub"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Settings="*res://scripts/core/settings.gd"
Save="*res://scripts/core/save.gd"
Events="*res://scripts/core/events.gd"
Game="*res://scripts/core/game_state.gd"
Levels="*res://scripts/core/level_registry.gd"
GameInput="*res://scripts/core/game_input.gd"
Sim="*res://scripts/core/sim.gd"
Audio="*res://scripts/core/audio_manager.gd"
Flow="*res://scripts/core/scene_flow.gd"
Autoplay="*res://scripts/core/autoplay.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[gui]

common/snap_controls_to_pixels=true
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

