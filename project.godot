[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

2d_render/layer_1="world"
2d_render/layer_2="ui"
2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="items"
2d_physics/layer_5="objects"
2d_physics/layer_6="hazards"
2d_physics/layer_7="platforms"
2d_physics/layer_8="hero_weapons"
2d_physics/layer_9="enemy_projectiles"
2d_physics/layer_10="triggers"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=false
environment/defaults/default_clear_color=Color(0.152941, 0.12549, 0.0941176, 1)
