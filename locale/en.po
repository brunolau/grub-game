# --- Level texts: signs (objects/sign) and hints (zones/message) of the level files, in level order ---
# Shown in the HUD face on a wooden board (signs) or on the hint panel (zones), wrapped to a few lines.
msgid "SIGN_W1_CLUB"
msgstr "Odd-looking ground? Club it - food hides everywhere!"

msgid "SIGN_W1_BOUNCE"
msgstr "Hold Jump as you land on a head to bounce up high!"

msgid "SIGN_W1_SPRING"
msgstr "Jump onto the springy flower to reach the vine bridges."

msgid "SIGN_W1_HOME"
msgstr "Home sweet tree house! Touch the totem to finish the stage."

msgid "SIGN_W1_VILLAGE"
msgstr "Canopy Village - climb up to the treetops!"

msgid "SIGN_W1_AXE"
msgstr "Axes fly far: press Attack to throw one!"

msgid "SIGN_W2_HATCH"
msgstr "Crouch on a hatch to drop through. Crouching charges your next blow!"

msgid "SIGN_W2_DARK"
msgstr "The deep caves are dark. Watch the threads!"

msgid "SIGN_W2_GLIDER"
msgstr "Run with the glider, then jump to take off. Up climbs, Down dives."

msgid "SIGN_W2_BRUTE"
msgstr "The Brute has the fire-starter. Charge a blow and club its head!"

msgid "SIGN_W3_ICE"
msgstr "Snow on ice is slippery! Let go early to stop in time."

msgid "SIGN_W3_ROCK"
msgstr "Blue rock gives a firm grip - ice floes do not."

msgid "SIGN_W3_WIND"
msgstr "Blizzard! Crouch to brace yourself when a gust blows."

msgid "SIGN_W3_LULL"
msgstr "Gusts cut your jumps short - leap in the lulls."

msgid "SIGN_W3_WATER"
msgstr "Something stirs in the icy water..."

msgid "SIGN_W3_FLOES"
msgstr "Hanging floes drop when you stand on them - keep moving!"

msgid "SIGN_W4_SHAFT"
msgstr "The shaft sinks as you move. Keep going down - the smoke above kills!"

msgid "SIGN_W4_EMBERS"
msgstr "Embers rain from the vents - keep moving and watch the sky!"

msgid "SIGN_W4_LAVA"
msgstr "Lava glows in the pits ahead - jump over them!"

msgid "SIGN_W4_COLOSSUS"
msgstr "Clubs glance off the Colossus! Axe its head from the black slab."

# 2.0 co-op, the ward mark (DESIGN.md G85): the sign at the first ward of co-op 1-1 (w1_l1_coop) and of co-op 5-1
# (w5_l1_coop). Enemies inside the ward of a two-caveman gate wear chalk stripes and give no bounce there.
msgid "SIGN_COOP_W1_WARD"
msgstr "Marked beasts are no stepping stones - use your partner's shoulders!"

msgid "SIGN_W5_COOP_WARD"
msgstr "Marked beasts are no stepping stones - use your partner's shoulders!"

# --- Level texts of the development levels (levels/test_*.lvl, not shipped) ---
msgid "SIGN_INTEGRATION_SPOTS"
msgstr "Club the ground - bonuses hide everywhere!"

msgid "SIGN_INTEGRATION_SPRING"
msgstr "Land on the spring to reach the ledge."

msgid "SIGN_INTEGRATION_BOSS"
msgstr "The Brute guards the fire-starter. Hit its head!"

msgid "SIGN_SHOWCASE"
msgstr "Every object of the jungle, one after another."

msgid "ZONE_DEMO"
msgstr "A hint shown while you stand here."
