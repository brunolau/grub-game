# Club & Grub - English catalogue (the source language).
# Owner: ui module. One file per language: copy this file to <locale>.po (for example de.po), set "Language"
# and translate the msgstr lines. Every .po file of this folder is loaded at start (scripts/ui/ui_kit.gd) and
# offered in Options > Language. msgid values are stable keys; {name} parts are filled in by the game.
# Headings drawn with the carved-stone font (TITLE / HEADING keys, UI_GAME_OVER, UI_THE_END) only have the
# letters A-Z, the digits and the space; keep them short.
msgid ""
msgstr ""
"Project-Id-Version: Club & Grub\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

