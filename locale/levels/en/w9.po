# --- Level names ---
msgid "Cloudbreak Climb"
msgstr "Cloudbreak Climb"

msgid "Thunderhead Glide"
msgstr "Thunderhead Glide"

msgid "The Roc's Spire"
msgstr "The Roc's Spire"

msgid "Storm Nest"
msgstr "Storm Nest"

# --- w9_l1 Cloudbreak Climb ---
msgid "SIGN_W9_CLIMB"
msgstr "The Roc nests above the clouds. Climb!"

# --- w9_l1b Thunderhead Glide ---
msgid "SIGN_W9_LIGHTNING"
msgstr "A dark cloud marks where lightning strikes."

# --- w9_l2 The Roc's Spire ---
msgid "SIGN_W9_GUST"
msgstr "Crouch to stand firm in the wind."

# --- co-op files (w9_l1_coop, w9_l1b_coop, w9_l2_coop, w9_l2b_coop) ---
msgid "SIGN_W9_COOP_SEESAW"
msgstr "One waits on the low end. One drops on the high end!"

msgid "SIGN_W9_COOP_PULLEY"
msgstr "Step on both lifts. One weighs his down, one hops his up!"

msgid "SIGN_W9_COOP_STORM"
msgstr "Two storm birds keep the wall. Strike both at once!"

msgid "SIGN_W9_COOP_BRACE"
msgstr "Crouch side by side: the charging rex stops dead."

msgid "SIGN_W9_COOP_ROC"
msgstr "One glides onto its back. One, no glider, strikes its tail!"
