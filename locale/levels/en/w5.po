# --- Level names ---
msgid "Red Mesa Trail"
msgstr "Red Mesa Trail"

msgid "Rattlesnake Gulch"
msgstr "Rattlesnake Gulch"

msgid "Tusker's Wallow"
msgstr "Tusker's Wallow"

msgid "Feast Land D"
msgstr "Feast Land D"

# --- w5_l1 Red Mesa Trail ---
msgid "SIGN_W5_BELT"
msgstr "Your club never leaves you. Press SWAP."

msgid "SIGN_W5_SPEAR"
msgstr "Throw the spear at a bark board: it sticks - a step!"

msgid "SIGN_W5_ROLLER"
msgstr "Rollers roll at you. Bounce on one to reach the mesa tops!"

# --- w5_l1_coop Red Mesa Trail (co-op) ---
msgid "SIGN_W5_COOP_EGG"
msgstr "Downed? You float in an egg - your partner whacks it open!"

msgid "SIGN_W5_COOP_TABLET"
msgstr "Two cavemen on a tablet: one caveman alone cannot pass."

msgid "SIGN_W5_COOP_HOP"
msgstr "One stands still, the other jumps on his head holding Jump!"

msgid "SIGN_W5_COOP_PLATES"
msgstr "Crouch on a plate to hold a door open for your partner."

msgid "SIGN_W5_COOP_GULLY"
msgstr "Twin tortoises: club one each at once, or one grows back!"

# --- w5_l2 Rattlesnake Gulch ---
msgid "SIGN_W5_VINE"
msgstr "Press Up at a vine to climb. Jump to let go."

msgid "SIGN_W5_ROLLED"
msgstr "A rolled vine? Strike it and it drops down."

# --- w5_l2_coop Rattlesnake Gulch (co-op) ---
msgid "SIGN_W5_COOP_SANDGATE"
msgstr "Crouch on the plate: the sand gate opens for the climber."

msgid "SIGN_W5_COOP_RATTLERS"
msgstr "Twin rattlers: club both quickly, or one grows back!"

# --- w5_l2b Tusker's Wallow ---
msgid "SIGN_W5_TUSKER"
msgstr "Tusker charges! Let him hit the wall, then club his head."

# --- w5_l2b_coop Tusker's Wallow (co-op) ---
msgid "SIGN_W5_COOP_TUSKER"
msgstr "He faces the nearer caveman: the other clubs his leafy rump!"

# --- bonus_d Feast Land D (Honey Falls) ---
msgid "SIGN_W5_HONEY"
msgstr "Honey holds your feet. Tap Jump to hop."

msgid "SIGN_W5_SODA"
msgstr "Stand on a soda vent when it fizzes!"
