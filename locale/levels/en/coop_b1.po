# --- w1_l1_coop Vine Bridges (co-op) ---
msgid "SIGN_COOP_W1_EGG"
msgstr "Fall or get hit and you float in an egg. Whack it to hatch!"

msgid "SIGN_COOP_W1_HOP"
msgstr "Stand under the ledge: your partner hops off your head!"

msgid "SIGN_COOP_W1_VINE"
msgstr "Up top? Club the coiled vine down for your partner."

msgid "SIGN_COOP_W1_PLATES"
msgstr "Crouch on a plate to hold its door open - then swap!"

msgid "SIGN_COOP_W1_SHELL"
msgstr "Shellbacks face the nearer caveman. Club the back!"

# --- w1_l2_coop Canopy Village (co-op) ---
msgid "SIGN_COOP_W1_TOTEM"
msgstr "Ride your partner's head. Jump just after he jumps!"

msgid "SIGN_COOP_W1_SHAFT"
msgstr "Too high to jump: land on your partner's head holding Up!"

msgid "SIGN_COOP_W1_DRUMS"
msgstr "Two drums, one beat: strike both at the same moment!"

# --- w2_l1_coop Echo Caverns (co-op) ---
msgid "SIGN_COOP_W2_HATCH"
msgstr "One crouches on the plate, the other drops through!"

msgid "SIGN_COOP_W2_RAPTOR"
msgstr "Raptors dodge clubs: bounce on one, your partner strikes!"
