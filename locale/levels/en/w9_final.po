# --- Level names ---
msgid "Chieftains' Pyre"
msgstr "Chieftains' Pyre"

msgid "The Long Raft Home"
msgstr "The Long Raft Home"

# --- w9_l3 Chieftains' Pyre ---
msgid "SIGN_W9_PYRE_CLIMB"
msgstr "The Tar Tribe camp! The Great Roast is on the summit."

msgid "SIGN_W9_PYRE_EGG"
msgstr "A fallen chieftain becomes an egg: smash it before it hatches!"

# --- ending_b The Long Raft Home: the push-off and the credits on floating signs ---
msgid "SIGN_RAFT_PUSH"
msgstr "Hop on the raft. Face the shore and strike to push off!"

msgid "SIGN_RAFT_HOME"
msgstr "The Great Roast is ours again. Next stop: home!"

msgid "SIGN_RAFT_TITLE"
msgstr "Club & Grub 2.0 - The Far Shore. Thank you for playing!"

msgid "SIGN_RAFT_MESA"
msgstr "Farewell, Sunbaked Canyon! Tusker still snores in his wallow."

msgid "SIGN_RAFT_ART"
msgstr "Heroes, beasts and lands: CC0 art by Pixel-boy and Sparklin Labs."

msgid "SIGN_RAFT_ART_MORE"
msgstr "More CC0 art: AAA, ansimuz, ghostpixxells, Pixel Frog and friends."

msgid "SIGN_RAFT_FEN"
msgstr "Farewell, Tar Fen! Old Mangrove creaks a goodbye."

msgid "SIGN_RAFT_MUSIC"
msgstr "Music: Juhani Junkala, Wolfgang_, Spring Spring and nene."

msgid "SIGN_RAFT_MUSIC_MORE"
msgstr "More music: Tallbeard, MintoDog and celestialghost8."

msgid "SIGN_RAFT_COAST"
msgstr "Farewell, Coral Coast! Inkjaw waves a tentacle."

msgid "SIGN_RAFT_SOUND"
msgstr "Sounds: Junkala, MoxieCat, Kenney, Spring Spring and more."

msgid "SIGN_RAFT_IDOLS"
msgstr "Farewell, Idol Ruins! The Twin Idols nap again."

msgid "SIGN_RAFT_FONTS"
msgstr "Fonts: Press Start 2P by CodeMan38, Pixelify Sans by Stefie Justprince."

msgid "SIGN_RAFT_SPIRE"
msgstr "Farewell, Sky Spire! The Roc keeps the rest of its feathers."

msgid "SIGN_RAFT_THANKS"
msgstr "Made with the Godot Engine. Home is near - smell the feast fires?"
