# --- Level names ---
msgid "Overgrown Steps"
msgstr "Overgrown Steps"

msgid "Hall of Idols"
msgstr "Hall of Idols"

msgid "Idol Court"
msgstr "Idol Court"

# --- w8_l1 Overgrown Steps ---
msgid "SIGN_W8_STEPS"
msgstr "Step on the stone plate to raise the stair."

msgid "SIGN_W8_GUARD"
msgstr "Its shield turns slowly. Strike its back."

msgid "SIGN_W8_MIMIC"
msgstr "Not every chest is a chest."

# --- w8_l2 Hall of Idols ---
msgid "SIGN_W8_GATES"
msgstr "Press Down on an arch to go through."

msgid "SIGN_W8_NICHE"
msgstr "Crouch on the hatch to drop. Wait for its back!"

# --- w8_l1_coop / w8_l2_coop: the co-op gates ---
msgid "SIGN_W8_COOP_HALL"
msgstr "Shells face the nearer hero. One baits, one drops in behind."

msgid "SIGN_W8_COOP_STAIRS"
msgstr "Heave the boulder onto a plate. Crouch on the other one!"

msgid "SIGN_W8_COOP_ROOMS"
msgstr "Crouch on a plate to hold the other room's door. Take turns."

msgid "SIGN_W8_COOP_SHAMAN"
msgstr "Pin the Shaman between you. Then one baits, one strikes."
