# --- w7_l1 Shell Beach ---
msgid "SIGN_W7_SURF"
msgstr "Ride the rafts. Water is deadly."

msgid "SIGN_W7_BLOWHOLE"
msgstr "A bubbling blowhole throws you up."

msgid "SIGN_W7_URCHIN"
msgstr "Chomper walks over urchins. You must jump them."

# --- w7_l2 Sea Caves ---
msgid "SIGN_W7_FLOE"
msgstr "Driftwood sinks. Keep moving."

# --- w7_l2b Squid Grotto ---
msgid "SIGN_W7_INKJAW"
msgstr "Inkjaw lurks below! Strike the top of its head."

# --- w7_l1_coop Shell Beach (co-op) ---
msgid "SIGN_W7_COOP_PLATES"
msgstr "Crouch on the stone plate to open a door for your partner."

msgid "SIGN_W7_COOP_LOB"
msgstr "Down + Swap curls you up. A high strike lobs your partner!"

# --- w7_l2_coop Sea Caves (co-op) ---
msgid "SIGN_W7_COOP_SEAGATE"
msgstr "Crouch on the plate to open the lower tunnel."

msgid "SIGN_W7_COOP_DRIVE"
msgstr "Curl up at the edge: a forward strike drives you across!"

# --- w7_l2b_coop Squid Grotto (co-op) ---
msgid "SIGN_W7_COOP_INKJAW"
msgstr "Strike both tentacles at once: one hero on each island!"
