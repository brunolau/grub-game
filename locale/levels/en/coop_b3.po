# --- w3_l2_coop Crystal Grotto (co-op) ---
msgid "SIGN_COOP_W3_SHELL"
msgstr "Shellbacks turn to the nearer caveman. Club the back!"

msgid "SIGN_COOP_W3_DRIVE"
msgstr "Curl up (Down + Swap) at the edge: your partner bats you over!"

msgid "SIGN_COOP_W3_DRUMS"
msgstr "Strike both drums at once: the floes freeze into a bridge."

msgid "SIGN_COOP_W3_CACHE"
msgstr "A crystal cache up the wall! Hop off your partner's head."

# --- ending_coop Way Home (co-op) ---
msgid "SIGN_COOP_END_GATE"
msgstr "The gate is barred! Hop onto the lookout off your partner."

# --- w4_l1_coop Cinder Shaft (co-op) ---
msgid "SIGN_COOP_W4_BOULDER"
msgstr "Push the boulder together: into the chute and onto the vent!"

msgid "SIGN_COOP_W4_CLIFF"
msgstr "The exit is up on the cliff: hop off your partner's head!"

# --- w4_l2_coop Obsidian Keep (co-op) ---
msgid "SIGN_COOP_W4_PLATES"
msgstr "One crouches on the plate, the other goes through - swap!"

msgid "SIGN_COOP_W4_DRUMS"
msgstr "Two drums, far apart: strike them together to lift the gate."

msgid "SIGN_COOP_W4_TOWER"
msgstr "The keep tower: a hop off your partner's head gets you up."

# --- w4_l2b_coop Colossus Hall (co-op) ---
msgid "SIGN_COOP_W4_VISOR"
msgstr "Crouch on the glowing plate - your partner throws the axe!"
