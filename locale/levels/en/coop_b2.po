msgid "SIGN_COOP_W2_SEESAW"
msgstr "One waits on the see-saw. The other drops on its high end!"

msgid "SIGN_COOP_W2_LIFT"
msgstr "Hold the plate and the pillar lifts your partner up."

msgid "SIGN_COOP_W2_BRACE"
msgstr "Bull Rex! Crouch side by side and it stops dead."

# --- w3_l1_coop Frost Summit (co-op) ---
msgid "SIGN_COOP_W3_BRACE"
msgstr "Bull Rex on the ice! Crouch side by side to stop it."

msgid "SIGN_COOP_W3_HOP"
msgstr "Too high? Hop off your partner's head, then drop the vine."

