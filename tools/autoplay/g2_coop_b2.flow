# Gate G2 (docs/expansion/PLAN.md 5): co-op, Book II, Beginner, two players on one keyboard from a fresh save, through
# the real UI over the co-op files of world 5 that exist at G2: title -> Play -> Co-op -> the join panel (P1 Space on
# the left half, P2 Num 0; both hold Strike - P1's classic Strike is Left Ctrl) -> book select (Book II) -> Beginner ->
# the Far Shore map -> w5_l1_coop, Rattlesnake Gulch w5_l2_coop with Tusker's Wallow w5_l2b_coop (the co-op Tusker),
# each played by its two-stream route, then Spore Hollow w6_l2_coop (the co-op campaign passes over 6-1, whose co-op
# file is phase 3; without w6_l2b_coop the stage ends at its own tally). Checks: no team wipe, both heroes at every
# stage start, co-op mode with a party of two. Owner: integration.
#   GD_TIMEOUT=1800 bash .tools/gd.sh play --flow=tools/autoplay/g2_coop_b2.flow --fast --fresh-user --out=g2_coop_b2

# --- Boot, title, Play > Co-op > join two players > Book II > Beginner -----------------------------------------------
wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 40
shot title
expect save.has_progress() == false
# Play, then Co-op (Flow.open_play(COOP); the keys of the title's Play / Solo / Co-op / Versus choice: ui-A, P1.11).
press ui_accept
wait 10
press ui_down
press ui_accept
wait_until flow.current_screen == join 300
wait_until flow.busy == false 600
# P1 joins with Space (left half), P2 with Num 0 (right half); both hold Strike to be ready (Flow.finish_join).
key Space
key Kp_0
wait 10
shot join_two
hold Ctrl Kp_Enter
# Ready = Strike held for 1 s of real time; the panel opens the book select by itself (ui-A's REPLY).
wait_until flow.current_screen == book_select 600
release all
wait_until flow.busy == false 600
press ui_right
wait 10
shot book_select_book2
press ui_accept
# Flow.choose_book(2) -> the difficulty (Beginner has the focus) -> Flow.start_selected_game -> the map.
wait_until flow.current_screen == mode_select 300
wait_until flow.busy == false 600
press ui_accept
wait_until flow.current_screen == world_map 600
wait_until flow.busy == false 600
expect game.book == 2
expect game.mode == 1
expect game.party == 2
expect game.difficulty == 0
expect game.lives == 2
expect game.score == 0

# --- w5_l1_coop -----------------------------------------------------------------------------------------------
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w5_l1
wait_until scene.countdown >= 0 600
shot map_w5_l1
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w5_l1_coop 600
expect hero.dead == false
expect level.hero_count() == 2
expect hero2.dead == false
expect game.weapon == 0
wait 2
shot w5_l1_coop_start
every 480 w5_l1_coop
play_file tools/autoplay/routes/w5_l1_coop.inputs
every 0
expect events.party_wiped == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
shot tally_w5_l1_coop
press ui_accept
wait 20
press ui_accept
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600

# --- w5_l2_coop -----------------------------------------------------------------------------------------------
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w5_l2
wait_until scene.countdown >= 0 600
shot map_w5_l2
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w5_l2_coop 600
expect hero.dead == false
expect level.hero_count() == 2
expect hero2.dead == false
expect game.weapon == 0
wait 2
shot w5_l2_coop_start
every 480 w5_l2_coop
play_file tools/autoplay/routes/w5_l2_coop.inputs
every 0
expect events.party_wiped == 0
# The linked stage follows without a tally.
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w5_l2b_coop 600
expect hero.dead == false
expect level.hero_count() == 2
expect hero2.dead == false
expect game.weapon == 0
wait 2
shot w5_l2b_coop_start
every 480 w5_l2b_coop
play_file tools/autoplay/routes/w5_l2b_coop.inputs
every 0
expect events.party_wiped == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
shot tally_w5_l2b_coop
press ui_accept
wait 20
press ui_accept
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600

# --- w6_l2_coop (the co-op campaign passes over a stop without a co-op file: 6-1's is phase 3) -----------------
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w6_l2
expect game.book == 2
expect game.mode == 1
wait_until scene.countdown >= 0 600
shot map_w6_l2
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w6_l2_coop 600
expect hero.dead == false
expect level.hero_count() == 2
expect hero2.dead == false
expect game.weapon == 0
wait 2
shot w6_l2_coop_start
every 480 w6_l2_coop
play_file tools/autoplay/routes/w6_l2_coop.inputs
every 0
expect events.party_wiped == 0
# Without w6_l2b_coop (phase 3) the stage ends at its own tally.
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
shot tally_w6_l2_coop
press ui_accept
wait 20
press ui_accept
wait 60
shot after_w6_l2_coop
