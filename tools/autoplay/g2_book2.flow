# Gate G2 (docs/expansion/PLAN.md 5): Book II "The Far Shore", Beginner, solo, from a fresh save, through the real UI
# over the stages that exist at G2 - world 5 (w5_l1, Rattlesnake Gulch w5_l2 with Tusker's Wallow w5_l2b) and world 6
# (Bubbling Fen w6_l1, Spore Hollow w6_l2 with Heart of the Mangrove w6_l2b) - each played by its club route, the
# linked stages without a tally, Tusker and Old Mangrove beaten, every tally (the run ends after 6-2 while world 7 does
# not exist). It is
# tools/autoplay/campaign_b2.flow cut before world 7 (that skeleton grows with phase 3). Owner: integration.
#   GD_TIMEOUT=1800 bash .tools/gd.sh play --flow=tools/autoplay/g2_book2.flow --fast --fresh-user --out=g2_book2

# --- Boot, title, Play > Solo > Book II > Beginner ----------------------------------------------------------------
wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 40
shot title
expect save.has_progress() == false
# Play, then Solo (Flow.open_play(SINGLE); the keys of the title's Play / Solo / Co-op / Versus choice: ui-A, P1.11).
press ui_accept
wait 10
shot play_menu
press ui_accept
wait_until flow.current_screen == book_select 300
wait_until flow.busy == false 600
press ui_right
wait 10
shot book_select_book2
press ui_accept
# Flow.choose_book(2) -> the difficulty (Beginner has the focus) -> Flow.start_selected_game -> the Far Shore map.
wait_until flow.current_screen == mode_select 300
wait_until flow.busy == false 600
press ui_accept
wait_until flow.current_screen == world_map 600
wait_until flow.busy == false 600
expect game.book == 2
expect game.mode == 0
expect game.party == 1
expect game.difficulty == 0
expect game.lives == 2
expect game.score == 0
expect game.weapon == 0

# --- w5_l1 ----------------------------------------------------------------------------------------------------
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w5_l1
wait_until scene.countdown >= 0 600
shot map_w5_l1
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w5_l1 600
expect hero.dead == false
expect game.weapon == 0
wait 2
shot w5_l1_start
every 480 w5_l1
play_file tools/autoplay/routes/w5_l1.inputs
every 0
expect events.player_died == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
shot tally_w5_l1
press ui_accept
wait 20
press ui_accept
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600

# --- w5_l2 ----------------------------------------------------------------------------------------------------
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w5_l2
wait_until scene.countdown >= 0 600
shot map_w5_l2
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w5_l2 600
expect hero.dead == false
expect game.weapon == 0
wait 2
shot w5_l2_start
every 480 w5_l2
play_file tools/autoplay/routes/w5_l2.inputs
every 0
expect events.player_died == 0
# The linked stage follows without a tally.
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w5_l2b 600
wait 2
shot w5_l2b_start
every 480 w5_l2b
play_file tools/autoplay/routes/w5_l2b.inputs
every 0
expect events.player_died == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
shot tally_w5_l2
press ui_accept
wait 20
press ui_accept
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600

