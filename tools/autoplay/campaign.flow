# --- 4-2 Obsidian Keep, then Colossus Hall (boss 2) ------------------------------------------------------------------
# On the world map.
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w4_l2
expect save.is_level_unlocked(w4_l2,1) == true
wait_until scene.countdown >= 0 600
shot map_w4_l2
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w4_l2 600
expect hero.dead == false
expect hud.shown_hearts == 3
wait 2
shot w4_l2_start
every 480 w4_l2
play_file tools/autoplay/routes/w4_l2.inputs
every 0
