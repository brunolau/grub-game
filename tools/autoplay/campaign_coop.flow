# Co-op, Books I AND II, BOTH difficulties, two players on one keyboard from a fresh save, through the 2.0 title path
# (docs/expansion/PLAN.md 6.2, DESIGN.md D.9 - D.11): title -> Play -> Co-op -> the join panel (P1 presses Jump on the
# left keyboard half, P2 on the numpad: the classic layout; both hold Strike) -> book select -> difficulty -> the map
# -> every stop of the book as its co-op file (`<id>_coop`, Levels.level_for_mode), each stage played by its two-stream
# route (`<id>_coop.inputs` Beginner, `<id>_coop.expert.inputs` Expert), the linked stages without a tally, the co-op
# bosses, one tribe tally per stop, the expert wall after the last Beginner stop and The End after the Expert ending.
# Four parts (`section`), each from the title: Book I Beginner, Book I Expert, Book II Beginner, Book II Expert.
# Checks: no team wipe, both heroes and the club in hand at every stage start, co-op mode with a party of two, every
# map stop recorded in the run's co-op save space.
# The headless twin is tests/test_coop_routes.gd test_the_coop_book{1,2}_{beginner,expert}_campaign_in_one_run.
# skeleton: every stop begins with `need` - its co-op files and routes. Until phase 3 is content complete a stop whose
# content has not landed ends its section (PENDING in the summary; Flow itself would pass over a stop without a
# co-op file) and the run goes on with the next section; the lint of tests/test_integration_flows.gd lists what is
# missing. At G3 the skeleton line goes and a missing `need` fails the run.
#   GD_TIMEOUT=5400 bash .tools/gd.sh play --flow=tools/autoplay/campaign_coop.flow --fast --fresh-user --out=campaign_coop
# Headless (no screenshots; tools/g3.sh runs it so):
#   GD_TIMEOUT=5400 bash .tools/gd.sh script res://scripts/core/dev/headless_flow.gd -- \
#       --flow=tools/autoplay/campaign_coop.flow --fast --fresh-user --user-dir=res://build/flow_user_campaign_coop

########################################################################################################################
# Co-op, Book I, Beginner
########################################################################################################################
section coop_book1_beginner
# Every part counts its own events: a stage that fails in one part (a wipe, a death) must not fail the
# `== 0` checks of the parts after it.
reset_events

# --- Title, Play > Co-op > Book I > Beginner --------------------------------------------------------------------------
wait_until flow.current_screen == title 900
wait_until flow.busy == false 600
wait 40
shot title_coop_book1_beginner
expect save.has_progress() == false
# Play, then Co-op (Flow.open_play; Solo has the focus, Co-op is one down).
press ui_accept
wait 10
press ui_down
press ui_accept
wait_until flow.current_screen == join 300
wait_until flow.busy == false 600
# P1 joins with Space (left half), P2 with Num 0 (right half); both hold Strike to be ready (P1's classic
# Strike is Left Ctrl). Ready = Strike held for 1 s of real time; the panel opens the book select itself.
key Space
key Kp_0
wait 10
shot join_coop_book1_beginner
hold Ctrl Kp_Enter
wait_until flow.current_screen == book_select 600
release all
wait_until flow.busy == false 600
press ui_accept
wait_until flow.current_screen == mode_select 300
wait_until flow.busy == false 600
expect flow.play_book == 1
# Left = Beginner, Right = Expert, whichever card the last run left focused.
press ui_left
wait 10
shot mode_select_coop_book1_beginner
press ui_accept
wait_until flow.current_screen == world_map 600
wait_until flow.busy == false 600
expect game.book == 1
expect game.mode == 1
expect game.party == 2
expect game.difficulty == 0
expect game.lives == 2
expect game.score == 0
expect game.weapon == 0

# --- w1_l1 in co-op ---------------------------------------------------------------------------------------------------
need w1_l1_coop tools/autoplay/routes/w1_l1_coop.inputs
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w1_l1
wait_until scene.countdown >= 0 600
shot map_w1_l1_coop_book1_beginner
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w1_l1_coop 600
expect hero.dead == false
expect level.hero_count() == 2
expect hero2.dead == false
# Fresh club (DESIGN.md C.1 rule 4): every Book II and co-op stage starts with the club in hand.
expect game.weapon == 0
wait 2
shot w1_l1_coop_start
every 480 w1_l1_coop
play_file tools/autoplay/routes/w1_l1_coop.inputs
every 0
expect events.party_wiped == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
shot tally_w1_l1_coop_book1_beginner
press ui_accept
wait 20
press ui_accept
# On to the map (checked by the next stop, after its `need`).

# --- w1_l2 in co-op ---------------------------------------------------------------------------------------------------
need w1_l2_coop tools/autoplay/routes/w1_l2_coop.inputs
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w1_l2
expect save.get_level_result_in(coop/book1/beginner,w1_l1).clears == 1
expect save.is_level_unlocked_in(coop/book1/beginner,w1_l2) == true
wait_until scene.countdown >= 0 600
shot map_w1_l2_coop_book1_beginner
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w1_l2_coop 600
expect hero.dead == false
expect level.hero_count() == 2
expect hero2.dead == false
# Fresh club (DESIGN.md C.1 rule 4): every Book II and co-op stage starts with the club in hand.
expect game.weapon == 0
wait 2
shot w1_l2_coop_start
every 480 w1_l2_coop
play_file tools/autoplay/routes/w1_l2_coop.inputs
every 0
expect events.party_wiped == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
shot tally_w1_l2_coop_book1_beginner
press ui_accept
wait 20
press ui_accept
# On to the map (checked by the next stop, after its `need`).

