########################################################################################################################
# Co-op, Book II, Beginner
########################################################################################################################
section coop_book2_beginner
# Every part counts its own events: a stage that fails in one part (a wipe, a death) must not fail the
# `== 0` checks of the parts after it.
reset_events

# --- Title, Play > Co-op > Book II > Beginner -------------------------------------------------------------------------
wait_until flow.current_screen == title 900
wait_until flow.busy == false 600
wait 40
shot title_coop_book2_beginner
# Play, then Co-op (Flow.open_play; Solo has the focus, Co-op is one down).
press ui_accept
wait 10
press ui_down
press ui_accept
wait_until flow.current_screen == join 300
wait_until flow.busy == false 600
# P1 joins with Space (left half), P2 with Num 0 (right half); both hold Strike to be ready (P1's classic
# Strike is Left Ctrl). Ready = Strike held for 1 s of real time; the panel opens the book select itself.
key Space
key Kp_0
wait 10
shot join_coop_book2_beginner
hold Ctrl Kp_Enter
wait_until flow.current_screen == book_select 600
release all
wait_until flow.busy == false 600
# The book select has Book I focused (Flow.play_book); Right = Book II.
press ui_right
wait 10
shot book_select_coop_book2_beginner
press ui_accept
wait_until flow.current_screen == mode_select 300
wait_until flow.busy == false 600
expect flow.play_book == 2
# Left = Beginner, Right = Expert, whichever card the last run left focused.
press ui_left
wait 10
shot mode_select_coop_book2_beginner
press ui_accept
wait_until flow.current_screen == world_map 600
wait_until flow.busy == false 600
expect game.book == 2
expect game.mode == 1
expect game.party == 2
expect game.difficulty == 0
expect game.lives == 2
expect game.score == 0
expect game.weapon == 0

