# Crystal Grotto is the last Beginner stop: the expert wall, then the title.
wait_until flow.current_screen == expert_wall 900
wait_until flow.busy == false 600
expect game.mode == 1
wait 90
shot expert_wall_coop
press ui_accept
wait_until flow.current_screen == title 900
wait_until flow.busy == false 600
wait 30
shot title_again
