# G1 vertical slice (docs/expansion/PLAN.md 4.2), co-op through the real UI: title -> Play -> Co-op -> the join panel
# (P1 presses Jump on the left keyboard half, P2 on the numpad: DESIGN.md D.11's classic layout, offered first in
# co-op; both hold Strike 1 s to be ready) -> book select (Book I) -> Beginner -> the map -> 1-1 Vine Bridges as its
# co-op file (levels/w1_l1_coop.lvl) played by its two-stream route (tools/autoplay/routes/w1_l1_coop.inputs) -> the
# tribe tally -> (the end of the co-op campaign on the G1 tree) -> the title. The first stop of tools/autoplay/campaign_coop.flow (phase 3: every stop), cut after the
# first stage so it runs on the G1 tree. Owner: integration.
#   GD_TIMEOUT=900 bash .tools/gd.sh play --flow=tools/autoplay/g1_coop.flow --fast --fresh-user --out=g1_coop

# --- Boot, title, Play > Co-op > join two players > Book I > Beginner -----------------------------------------------
wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 40
shot title
expect save.has_progress() == false
# Play, then Co-op (Flow.open_play(COOP); the keys of the title's Play / Solo / Co-op / Versus choice: ui-A, P1.11).
press ui_accept
wait 10
press ui_down
press ui_accept
wait_until flow.current_screen == join 300
wait_until flow.busy == false 600
# P1 joins with Space (left half), P2 with Num 0 (right half); both hold Strike to be ready (Flow.finish_join).
key Space
key Kp_0
wait 10
shot join_two
hold Ctrl Kp_Enter
# Ready = Strike held for 1 s of real time (PartyTuning.JOIN_READY_HOLD_TICKS); the panel opens the book select by
# itself 0.6 s after both are ready (ui-A's REPLY in build/engine_requests/wf7_integration_to_ui-A.txt).
wait_until flow.current_screen == book_select 600
release all
wait_until flow.busy == false 600
press ui_accept
# Flow.choose_book(1) -> the difficulty (Beginner has the focus) -> Flow.start_selected_game -> the map.
wait_until flow.current_screen == mode_select 300
wait_until flow.busy == false 600
press ui_accept
wait_until flow.current_screen == world_map 600
wait_until flow.busy == false 600
expect game.book == 1
expect game.mode == 1
expect game.party == 2
expect game.difficulty == 0
expect game.lives == 2
expect game.score == 0

# --- w1_l1_coop -----------------------------------------------------------------------------------------------
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w1_l1
wait_until scene.countdown >= 0 600
shot map_w1_l1
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w1_l1_coop 600
expect hero.dead == false
expect level.hero_count() == 2
expect hero2.dead == false
expect game.weapon == 0
wait 2
shot w1_l1_coop_start
every 480 w1_l1_coop
play_file tools/autoplay/routes/w1_l1_coop.inputs
every 0
expect events.party_wiped == 0
expect events.hero_down == 0
expect events.hero_died == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
shot tally_w1_l1_coop
press ui_accept
wait 20
press ui_accept
# On the G1 tree w1_l1_coop is the only co-op file of Book I, so the co-op campaign has no next stop: Flow.finish_tally
# records the result in the co-op namespace and ends the run at the expert wall (tools/autoplay/campaign_coop.flow
# continues on the map once w1_l2_coop exists). Then the title.
wait_until flow.current_screen == expert_wall 900
wait_until flow.busy == false 600
expect game.mode == 1
expect game.party == 2
expect save.get_level_result_in(coop/book1/beginner,w1_l1).clears == 1
expect save.get_level_result_in(single/book1/beginner,w1_l1).clears == 0
wait 60
shot end_of_coop_campaign
press ui_accept
wait_until flow.current_screen == title 900
wait_until flow.busy == false 600
wait 20
shot title_again
