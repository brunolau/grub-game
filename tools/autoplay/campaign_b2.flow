expect save.get_level_result_in(single/book2/expert,w9_l2).clears == 1
expect save.is_level_unlocked_in(single/book2/expert,w9_l3) == true
wait_until scene.countdown >= 0 600
shot map_w9_l3_book2_expert
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w9_l3 600
