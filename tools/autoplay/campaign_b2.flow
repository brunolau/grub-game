# The trophy ends the stop (its result is recorded at once) and starts the epilogue stage without
# a tally.
expect events.boss_defeated >= 1
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == ending_b 600
expect hero.dead == false
# Fresh club (DESIGN.md C.1 rule 4): every Book II and co-op stage starts with the club in hand.
