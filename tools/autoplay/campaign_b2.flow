# On to the map (checked by the next stop, after its `need`).

# --- w8_l1 ------------------------------------------------------------------------------------------------------------
need w8_l1 tools/autoplay/routes/w8_l1.inputs
wait_until flow.current_screen == world_map 900
wait_until flow.busy == false 600
expect flow.args.level_id == w8_l1
expect save.get_level_result_in(single/book2/expert,w7_l2).clears == 1
expect save.is_level_unlocked_in(single/book2/expert,w8_l1) == true
wait_until scene.countdown >= 0 600
shot map_w8_l1_book2_expert
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == w8_l1 600
expect hero.dead == false
# Fresh club (DESIGN.md C.1 rule 4): every Book II and co-op stage starts with the club in hand.
expect game.weapon == 0
wait 2
shot w8_l1_start
every 480 w8_l1
play_file tools/autoplay/routes/w8_l1.inputs
every 0
expect events.player_died == 0
wait_until flow.current_screen == tally 900
wait_until flow.busy == false 600
wait 30
shot tally_w8_l1_book2_expert
press ui_accept
wait 20
press ui_accept
