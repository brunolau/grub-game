# Squid Grotto is the last Beginner stage of Book II: the expert wall, then the title.
wait_until flow.current_screen == expert_wall 900
wait_until flow.busy == false 600
expect game.book == 2
wait 90
shot expert_wall_book2
press ui_accept
wait_until flow.current_screen == title 900
wait_until flow.busy == false 600
wait 30
shot title_again
