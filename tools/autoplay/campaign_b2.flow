press ui_accept
wait 20
press ui_accept

# --- The End ----------------------------------------------------------------------------------------------------------
wait_until flow.current_screen == the_end 900
wait_until flow.busy == false 600
expect save.is_game_completed_in(single/book2/expert) == true
expect game.lives >= 2
wait 90
shot the_end_book2_expert
