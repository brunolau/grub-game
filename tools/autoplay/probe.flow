# Probe: boot to the first level of the campaign (1-1 Vine Bridges) and walk a few steps.
#   bash .tools/gd.sh play --flow=tools/autoplay/probe.flow --fast --fresh-user
wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 30
shot title
press ui_accept
wait_until flow.current_screen == mode_select 300
wait_until flow.busy == false 600
wait 20
shot mode_select
press ui_accept
wait_until flow.current_screen == world_map 300
wait_until flow.busy == false 600
wait 30
shot world_map
wait_until flow.current_screen == level 600
wait_until flow.busy == false 600
expect level.level_id == w1_l1
wait 5
shot level_intro
play 60:R,10:RU,40:R
shot after_walk
log hero.sim_pos game.score flow.current_screen
