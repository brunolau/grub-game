# Gate G2 (docs/expansion/PLAN.md 5: "the four launch modes run with Hunter bots on three arenas"), versus through
# the real UI for the three modes phase 2 added, each on a phase-2 arena: title -> Play -> Versus -> the lobby (P1
# presses Jump on the left keyboard half, P2 on the numpad; two CPU seats as Hunters) -> the rules (Last Caveman
# Standing, first to 1 round win) -> the arena select (Echo Hollow) -> the round(s) -> the results -> the lobby ->
# Hot Rock on Cinder Pit -> the lobby -> Clubball on Coconut Cove -> the results -> the title. The humans press
# nothing during the rounds (their heroes read the keyboard halves); the Hunters are core-B's HeroBots on DA's graphs.
# Grub Stack on the Totem Ring is tools/autoplay/g1_versus.flow; every (arena, mode) with four Hunters is the slow
# module tests/test_versus_bots.gd. Owner: integration.
#   GD_TIMEOUT=1800 bash .tools/gd.sh play --flow=tools/autoplay/g2_versus.flow --fast --fresh-user --out=g2_versus

# --- Boot, title, Play > Versus, seats -----------------------------------------------------------------------------
wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 40
press ui_accept
wait 10
press ui_down
press ui_down
wait 6
press ui_accept
wait_until flow.current_screen == versus_lobby 300
wait_until flow.busy == false 600
wait 10
key Space
key Kp_0
wait 10
expect game.versus_match.get_seat(0).kind == 1
expect game.versus_match.get_seat(1).kind == 1
# The focus starts on START: Up = Teams, Up = card 1, Right twice = the free card 3; confirm on a free card adds a
# Hunter; Right = card 4, confirm = a second Hunter; a card's Up = START.
press ui_up
press ui_up
press ui_right
press ui_right
press ui_accept
wait 4
press ui_right
press ui_accept
wait 10
expect game.versus_match.player_count() == 4
expect game.versus_match.is_bot(2) == true
expect game.versus_match.is_bot(3) == true
expect game.versus_match.get_seat(2).bot_level == 1
expect game.versus_match.get_seat(3).bot_level == 1
press ui_up
wait 6
shot lobby_two_hunters

# --- Match 1: Last Caveman Standing on echo_hollow ------------------------------------------------------------
hold Ctrl Kp_Enter
wait_until game.versus_match.can_start() == true 600
release all
wait 10
press ui_accept
wait_until flow.current_screen == versus_rules 300
wait_until flow.busy == false 600
wait 10
press ui_right
wait 4
expect game.versus_match.mode == 1
# Down twice = Rounds; Right = first to 1 round win (a short match per mode).
press ui_down
press ui_down
press ui_right
wait 4
expect game.versus_match.rounds_to_win == 1
press ui_up
press ui_up
wait 6
shot rules_echo_hollow
# Up from the Mode row: "Choose the arena".
press ui_up
press ui_accept
wait_until flow.current_screen == versus_arena 300
wait_until flow.busy == false 600
wait 10
press ui_right
wait 4
press ui_right
wait 4
expect game.versus_match.arena == arena_echo_hollow
shot arena_echo_hollow
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == arena_echo_hollow 600
expect game.mode == 2
expect level.hero_count() == 4
input device
wait 2
shot echo_hollow_intro
every 480 echo_hollow
wait_until flow.current_screen == versus_results 30000
every 0
wait_until flow.busy == false 600
wait 90
shot results_echo_hollow
expect game.versus_match.is_over() == true
expect game.versus_match.mode == 1

# --- Match 2: Hot Rock on cinder_pit ------------------------------------------------------------
# From the results: Right + confirm = the lobby (seats kept); both humans ready again, START.
press ui_right
press ui_accept
wait_until flow.current_screen == versus_lobby 600
wait_until flow.busy == false 600
wait 20
hold Ctrl Kp_Enter
wait_until game.versus_match.can_start() == true 600
release all
wait 10
press ui_accept
wait_until flow.current_screen == versus_rules 300
wait_until flow.busy == false 600
wait 10
press ui_right
wait 4
expect game.versus_match.mode == 2
wait 6
shot rules_cinder_pit
# Up from the Mode row: "Choose the arena".
press ui_up
press ui_accept
wait_until flow.current_screen == versus_arena 300
wait_until flow.busy == false 600
wait 10
press ui_left
wait 4
expect game.versus_match.arena == arena_cinder_pit
shot arena_cinder_pit
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == arena_cinder_pit 600
expect game.mode == 2
expect level.hero_count() == 4
input device
wait 2
shot cinder_pit_intro
every 480 cinder_pit
wait_until flow.current_screen == versus_results 30000
every 0
wait_until flow.busy == false 600
wait 90
shot results_cinder_pit
expect game.versus_match.is_over() == true
expect game.versus_match.mode == 2

# --- Match 3: Clubball on coconut_cove ------------------------------------------------------------
# From the results: Right + confirm = the lobby (seats kept); both humans ready again, START.
press ui_right
press ui_accept
wait_until flow.current_screen == versus_lobby 600
wait_until flow.busy == false 600
wait 20
hold Ctrl Kp_Enter
wait_until game.versus_match.can_start() == true 600
release all
wait 10
press ui_accept
wait_until flow.current_screen == versus_rules 300
wait_until flow.busy == false 600
wait 10
press ui_right
wait 4
expect game.versus_match.mode == 3
wait 6
shot rules_coconut_cove
# Up from the Mode row: "Choose the arena".
press ui_up
press ui_accept
wait_until flow.current_screen == versus_arena 300
wait_until flow.busy == false 600
wait 10
press ui_right
wait 4
expect game.versus_match.arena == arena_coconut_cove
shot arena_coconut_cove
press ui_accept
wait_until flow.current_screen == level 900
wait_until flow.busy == false 600
wait_until level.level_id == arena_coconut_cove 600
expect game.mode == 2
expect level.hero_count() == 4
input device
wait 2
shot coconut_cove_intro
every 480 coconut_cove
wait_until flow.current_screen == versus_results 30000
every 0
wait_until flow.busy == false 600
wait 90
shot results_coconut_cove
expect game.versus_match.is_over() == true
expect game.versus_match.mode == 3

# --- Back to the lobby and the title ------------------------------------------------------------------------------
press ui_right
press ui_accept
wait_until flow.current_screen == versus_lobby 600
wait_until flow.busy == false 600
wait 20
press ui_cancel
wait_until flow.current_screen == title 600
wait_until flow.busy == false 600
wait 20
shot title_again
